BEGIN;
INSERT INTO rule_sets VALUES ('2026.09-draft1', 'LMPC-2011-TEXT', 'Legal Metrology (Packaged Commodities) Rules, 2011 — machine-readable rules (as per uploaded 2011 text)', 'draft', '{"RETAIL_SCOPE": {"description": "Chapter II applies: retail package, not industrial/institutional, not >25 kg/l (cement & fertilizer bags up to 50 kg stay in scope). Rule 3.", "condition": {"all": [{"fact": "package.level", "op": "eq", "value": "retail"}, {"fact": "package.intended_for", "op": "not_in", "value": ["industrial", "institutional"], "absent_as": true}, {"any": [{"not": {"fact": "net_quantity.dimension", "op": "in", "value": ["mass", "volume"], "absent_as": false}}, {"fact": "net_quantity.base_value", "op": "lte", "value": 25000}, {"all": [{"fact": "product.tags", "op": "contains_any", "value": ["cement", "fertilizer"]}, {"fact": "net_quantity.base_value", "op": "lte", "value": 50000}]}]}]}}, "RULE26_EXEMPT": {"description": "Whole Rules do not apply (Rule 26 a-d).", "condition": {"any": [{"all": [{"fact": "net_quantity.dimension", "op": "in", "value": ["mass", "volume"], "absent_as": false}, {"fact": "net_quantity.base_value", "op": "lte", "value": 10}]}, {"fact": "product.tags", "op": "contains", "value": "fast_food_restaurant_packed"}, {"fact": "product.tags", "op": "contains", "value": "drug_dpco_formulation"}, {"all": [{"fact": "product.tags", "op": "contains", "value": "agricultural_farm_produce"}, {"fact": "net_quantity.base_value", "op": "gt", "value": 50000}]}]}}, "SMALL_PACKAGE_5CC": {"description": "Package capacity 5 cubic cm or less (Rules 7(1), 10(1) proviso, 12(7)).", "condition": {"fact": "package.capacity_cc", "op": "lte", "value": 5, "absent_as": false}}}'::jsonb, '{"_convention": "Every fact is {value, confidence, evidence:{image_id,bbox}, human_value?, verification_status?}. Engine uses human_value when verification_status == VERIFIED.", "inspection.date": "date the inspection is judged under (selects rule versions)", "inspection.input_type": "package | advertisement", "extraction.coverage_complete": "true when all panels were photographed and OCR quality passed; lets a missing declaration count as ABSENT (not just undetected)", "product.tags": "array of commodity classes (food, cosmetic, biscuits, soap, towel, alcoholic_beverage, ...) from classifier/officer", "product.physical_state": "solid | semi_solid | viscous | solid_liquid_mixture | liquid | cubic_measure | linear | area | countable", "product.common_name": "generic name", "product.is_imported": "bool", "product.country_of_manufacture": "string", "product.packed_in_india": "bool", "package.level": "retail | wholesale | export", "package.intended_for": "consumer | industrial | institutional", "package.capacity_cc": "number", "package.is_multi_product": "bool", "package.components": "[{name, quantity}]", "package.is_component_set": "bool", "package.has_outer_wrapper": "bool", "package.retail_package_count": "number", "manufacturer|packer|importer.name": "string", "manufacturer|packer|importer.address": "{text, street, city, state, pin, country}", "manufacturer.role_qualified": "bool — ''Manufactured by''/''Packed by''/''Marketed by'' present", "parties.packer_is_distinct": "bool", "net_quantity.text": "raw declaration text", "net_quantity.value": "number", "net_quantity.unit": "string", "net_quantity.dimension": "DERIVED mass|volume|length|area|number", "net_quantity.base_value": "DERIVED value in g/ml/cm/cm2/count", "net_quantity.clearance": "{above, below, left, right, numeral_height} in pixels (vision)", "net_quantity.contrast_ratio | mrp.contrast_ratio": "number (vision)", "date_of_manufacture": "{month, year, print_method}", "mrp.text": "raw", "mrp.value": "number (INR)", "mrp.tamper_detected": "bool (vision)", "mrp.on_crown_cap_or_bottle": "bool", "consumer_care": "{name, designation, address, phone, email}", "dimensions": "{text, item_count, pieces_differ, pieces:[{dimensions, rsp}]}", "sheets": "{count, dimensions}", "containers": "{shape, count, length, width, depth, diameter}", "label.full_text": "all OCR text", "label.declaration_languages": "array of BCP-47-ish codes: en, hi-Deva, ...", "label.stickers": "[{type, covers_mandatory_declaration, revised_mrp, covers_original_mrp}]", "label.numeral_height_mm | label.pdp_area_cm2 | label.min_letter_height_mm | label.min_letter_width_ratio": "MEASUREMENT (needs scale)", "label.is_embossed": "bool", "label.min_declaration_ocr_confidence": "number", "label.all_declarations_grouped_on_pdp": "bool (vision)", "measurement.actual_net_quantity_base": "number (officer)", "measurement.sample_net_quantities_base": "array (officer)", "measurement.lot_size": "number", "transaction.selling_price": "number (officer)", "registry.*": "external lookups", "other_law.*": "flags telling the engine another statute governs"}'::jsonb, NULL, 'c80cef83edb982b4be0f1979e61f6507132dcbb7ff5c1fe1df306800d055805c');
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:4', 'LMPC Rules 2011', '4', '4', 'no person shall pre-pack ... unless the package ... bears thereon or, a label is securely affixed thereto such declarations as are required', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:5 + Second Schedule', 'LMPC Rules 2011', '5 + Second Schedule', '4', 'The commodities specified in the Second Schedule shall be packed ... in such standard quantities as are specified in that Schedule', '2011-04-01', '2022-03-31') ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:5 proviso', 'LMPC Rules 2011', '5 proviso', '4', 'a declaration that ''Not a standard pack size under the Legal Metrology (Packaged Commodities) Rules, 2011'' ... shall be made prominently', '2011-04-01', '2012-06-30') ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:Second Schedule, Sl. 10', 'LMPC Rules 2011', 'Second Schedule, Sl. 10', '30', 'If the net quantity is declared by volume, then the equivalent quantity in terms of mass to be declared in brackets in same size of letters/numerals', '2011-04-01', '2022-03-31') ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(a), 10(1)', 'LMPC Rules 2011', '6(1)(a), 10(1)', '5', 'the name and address of the manufacturer ... shall be mentioned', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(a), 10(1) Explanation', 'LMPC Rules 2011', '6(1)(a), 10(1) Explanation', '11', '''complete address'' means ... the name of the street, number (if any) ... and either the name of the city and State ... or the Postal Index Number [PIN] Code', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:10(1) second proviso', 'LMPC Rules 2011', '10(1) second proviso', '11', 'where any commodity manufactured outside India is packed in India, the package shall also contain on the principal display panel the name and complete address of the packer or the importer in India', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:10(1) first proviso, 12(7)', 'LMPC Rules 2011', '10(1) first proviso, 12(7)', '11', 'for packages of capacity 5 cubic cm or less, it shall be a sufficient compliance ... if a mark or inscription which would enable the consumer to identify the manufacturer or packer or the importer ... is made', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:10(2)', 'LMPC Rules 2011', '10(2)', '11', 'The name of the manufacturer or packer or importer shall be the actual corporate name, or if not incorporated, the name under which the business is conducted', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(a) Explanation I & II', 'LMPC Rules 2011', '6(1)(a) Explanation I & II', '5', 'If any name and address of a company is mentioned on the label without any qualifying words ''manufactured by'' or ''packed by'', it shall be presumed that such name and address shall be that of the manufacturer', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(b)', 'LMPC Rules 2011', '6(1)(b)', '5', 'The common or generic names of the commodity contained in the package', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(c)', 'LMPC Rules 2011', '6(1)(c)', '5', 'The net quantity, in terms of the standard unit of weight or measure ... or ... the number of the commodity contained in the package', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:12(7)', 'LMPC Rules 2011', '12(7)', '13', 'the declaration of quantity shall be made on a tag, card, tape, or any other similar device affixed to the container in such a manner that it cannot be removed without opening the container', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:11(2)-(4) + Third Schedule', 'LMPC Rules 2011', '11(2)-(4) + Third Schedule', '12', 'the declaration of quantity on such package shall not be qualified by the words ''when packed'' or the like ... [except] as specified in the Third Schedule', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:12(2) + Fourth Schedule', 'LMPC Rules 2011', '12(2) + Fourth Schedule', '12', 'the declaration of quantity shall be in terms of the unit of (a) mass, if the commodity is solid, semi-solid, viscous or a mixture of solid and liquid; ... (d) volume, if the commodity is liquid', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:12(6)', 'LMPC Rules 2011', '12(6)', '13', 'words or expressions like-''minimum'', ''not less than'', ''average'', ''about'', approximately'' or other words of a similar nature', '2011-04-01', '2012-06-30') ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:12(6) as amended', 'LMPC Rules 2011', '12(6) as amended', '13', 'The declaration of quantity under these Rules shall not contain any word or expression of any sort, whatsoever, which tends to create or likely to create an exaggerated, misleading or inadequate expression', '2012-07-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:13(2), 13(3)', 'LMPC Rules 2011', '13(2), 13(3)', '13', 'When expressing a quantity less than (a) one kilogram, the unit of weight shall be the gram ... equal to or more than (a) one kilogram, the unit of weight shall be the kilogram', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:13(4)', 'LMPC Rules 2011', '13(4)', '14', 'No number called the dozen, score, gross, great gross or the like shall be specified or indicated on any package.', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:13(5)(i)', 'LMPC Rules 2011', '13(5)(i)', '14', 'No system of units other than the International System of Units shall be used in furnishing the net quantity', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:13(5)(ii)', 'LMPC Rules 2011', '13(5)(ii)', '14', 'For items sold by number the symbol should be N or U.', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(d)', 'LMPC Rules 2011', '6(1)(d)', '5', 'The month and year in which the commodity is manufactured or pre-packed or imported shall be mentioned in the package.', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(d) 3rd proviso (withdrawn)', 'LMPC Rules 2011', '6(1)(d) 3rd proviso (withdrawn)', '6', 'a manufacturer may indicate the month and year using a rubber stamp without overwriting. * Provisio will stand withdrawn wef 01.07.2012', '2012-07-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(e)', 'LMPC Rules 2011', '6(1)(e)', '6', 'the retail sale price of the package', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:2(m), 8(2)', 'LMPC Rules 2011', '2(m), 8(2)', '3', '''Maximum or Max. retail price Rs/ .......inclusive of all taxes or in the form MRP Rs/ .........incl., of all taxes', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:2(m)', 'LMPC Rules 2011', '2(m)', '3', 'fraction of less than fifty paisa to be rounded off to the preceding rupees and fraction of above 50 paise and up to 95 paise to the rounded off to fifty paise', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(3)', 'LMPC Rules 2011', '6(3)', '7', 'It shall not be permissible to affix individual stickers on the package for altering or making declaration required under these rules', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(3) proviso', 'LMPC Rules 2011', '6(3) proviso', '7', 'for reducing the Maximum Retail Price (MRP), a sticker with the revised lower MRP (inclusive of all taxes) may be affixed and the same shall not cover the MRP declaration made by the manufacturer', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:18(5), 18(6)', 'LMPC Rules 2011', '18(5), 18(6)', '17', 'No wholesale dealer or retail dealer or other person shall obliterate, smudge or alter the retail sale price', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:18(2)', 'LMPC Rules 2011', '18(2)', '16', 'No retail dealer or other person ... shall make any sale of any commodity in packed form at a price exceeding the retail sale price', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1)(f), 12(4), 15', 'LMPC Rules 2011', '6(1)(f), 12(4), 15', '6', 'Where the sizes of the commodity contained in the package are relevant, the dimensions of the commodity ... shall be mentioned', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:14', 'LMPC Rules 2011', '14', '14', 'Where a package contains commodities like bed-sheets, hemmed fabric materials, dhoties, sarees, napkins, pillow-covers, towels, table cloths ... the number and the dimensions of finished size ... shall also be declared', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:14 first proviso', 'LMPC Rules 2011', '14 first proviso', '14', 'where the package contains more than one piece of different dimensions, the package shall also contain a declaration as to the dimensions and the retail sale price of each such piece', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:14 second proviso', 'LMPC Rules 2011', '14 second proviso', '14', 'the dimensions of the commodities and the sale price thereof shall also be marked on each individual piece', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:16', 'LMPC Rules 2011', '16', '15', 'In the case of a package containing sheets like aluminum foil, facial tissues, waxed paper, toilet paper ... a statement as to the number of usable sheets ... and the dimensions of each such sheet', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:17(i)-(iii)', 'LMPC Rules 2011', '17(i)-(iii)', '15', 'for bag-type commodities, the number of bags ... followed by linear dimensions; ... square, oblong ... length, width, and if required, depth; ... circular ... diameter', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:17(iv)', 'LMPC Rules 2011', '17(iv)', '15', 'when the use of a container is related by label references ... to the capability of the container to hold a specific quantity ... such references shall be included in the declaration of quantity', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(2)', 'LMPC Rules 2011', '6(2)', '7', 'Every package shall bear the name, address, telephone number, e mail address, if available, of the person who can be or the office which can be, contacted, in case of consumer complaints.', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(2) as amended', 'LMPC Rules 2011', '6(2) as amended', '7', '[amended text to be pasted from Gazette]', '2018-01-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(5)', 'LMPC Rules 2011', '6(5)', '7', 'the declaration ... shall appear on the main package and such package shall also carry information about the other accompanying packages', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:7(2)(i) Table-I', 'LMPC Rules 2011', '7(2)(i) Table-I', '8', '[Table summary] Up to 200 g/ml: 1 mm (2 mm if blown/embossed); above 200 up to 500: 2 mm (4); above 500: 4 mm (6)', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:7(2)(ii) Table-II', 'LMPC Rules 2011', '7(2)(ii) Table-II', '9', '[Table summary] PDP up to 100 cm2: 1 mm (2); above 100 up to 500: 2 (4); above 500 up to 2500: 4 (6); above 2500: 6 (6)', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:7(3)', 'LMPC Rules 2011', '7(3)', '8', 'The height of letters in the declaration shall not be less than 1 mm height and when blown, formed, molded, embossed or perforated, the height of letters shall not be less than 2 mm. Provided that the width of the letter or numeral shall not be less than one third of its height', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:8(1), 2(h)', 'LMPC Rules 2011', '8(1), 2(h)', '9', 'Every declaration required to be made under these rules shall appear on the principal display panel.', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:8(1) proviso', 'LMPC Rules 2011', '8(1) proviso', '9', 'free from printed information (a) above and below by a space equal to at least the height of the numeral ... (b) to the left and right by a space at least twice the height of numeral', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:9(1)(a), 9(1) proviso (b)', 'LMPC Rules 2011', '9(1)(a), 9(1) proviso (b)', '10', 'Every declaration ... shall be (a) legible and prominent', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:9(1)(b)', 'LMPC Rules 2011', '9(1)(b)', '10', 'numerals of the retail sale price and net quantity declaration shall be printed ... in a colour that contrasts conspicuously with the background', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:9(2)', 'LMPC Rules 2011', '9(2)', '10', 'No declaration shall be made so as to require it to be read through any liquid commodity contained in the package.', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:9(3)', 'LMPC Rules 2011', '9(3)', '10', 'Where a package is provided with an outside container or wrapper such container or wrapper shall also contain all the declarations ... except where such container or wrapper itself is transparent', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:9(4)', 'LMPC Rules 2011', '9(4)', '10', 'The particulars of the declarations ... shall either be in Hindi in Devnagri script or in English', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:21(2)-(3), 22, First Schedule', 'LMPC Rules 2011', '21(2)-(3), 22, First Schedule', '21', 'whether the deficiency is more than the maximum permissible error in relation to that commodity', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:19(6), Fifth & Sixth Schedule', 'LMPC Rules 2011', '19(6), Fifth & Sixth Schedule', '19', 'the statistical average of the net quantity ... is equal to, or more than, the quantity declared ... the extent of error in deficiency in none of such sample packages exceeds the maximum permissible error', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:23 Explanation', 'LMPC Rules 2011', '23 Explanation', '22', '''deceptive package'' means a package which is so designed as to deliberately given to the consumer an exaggerated or misleading impression as to the quantity', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:24(a)', 'LMPC Rules 2011', '24(a)', '23', 'The name and address of the manufacturer or importer or where the manufacturer or importer is not the packer, of the packer', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:24(b)', 'LMPC Rules 2011', '24(b)', '23', 'the identity of the commodity contained in the package', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:24(c)', 'LMPC Rules 2011', '24(c)', '23', 'the total number of retail package contained in such wholesale package or the net quantity', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:25', 'LMPC Rules 2011', '25', '23', 'An export package shall not be sold in India unless the manufacturer or packer has re-packed or relabeled the commodity in accordance with the provisions contained in Chapter II', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:27', 'LMPC Rules 2011', '27', '24', 'Every individual, firm ... who or which pre-packs or imports any commodity for sale ... shall make an application ... for the registration', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:31', 'LMPC Rules 2011', '31', '26', 'Any advertisement mentioning the retail sale price ... shall contain a declaration as to the net quantity ... The font size of the net quantity ... shall be same as that of retail sale price.', '2011-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES ('LMPC2011:6(1) as amended (unit sale price)', 'LMPC Rules 2011', '6(1) as amended (unit sale price)', NULL, '[amended text to be pasted from Gazette]', '2022-04-01', NULL) ON CONFLICT DO NOTHING;
INSERT INTO rules VALUES ('LMPC-R4-001', 1, 'active', 'Declarations borne on package or on a securely affixed label', 'MANDATORY_DECLARATION', 'LMPC2011:4', '{"source": "LMPC Rules 2011", "rule": "4", "pdf_page": 4, "text_excerpt": "no person shall pre-pack ... unless the package ... bears thereon or, a label is securely affixed thereto such declarations as are required"}'::jsonb, 'MANUAL_INSPECTION', 'HIGH', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "label.affixation", "op": "in", "value": ["printed_on_package", "securely_affixed_label"]}'::jsonb, 'NON_COMPLIANT', 'Declarations are not printed on the package or on a securely affixed label.', '["label.affixation"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R4-001', 1);
INSERT INTO rules VALUES ('LMPC-R5-001', 1, 'active', 'Commodity packed in a Second Schedule standard quantity', 'STANDARD_PACK_SIZE', 'LMPC2011:5 + Second Schedule', '{"source": "LMPC Rules 2011", "rule": "5 + Second Schedule", "pdf_page": 4, "text_excerpt": "The commodities specified in the Second Schedule shall be packed ... in such standard quantities as are specified in that Schedule"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fn": "is_second_schedule_commodity", "args": {}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "standard_pack_size_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Declared quantity is not a standard pack size for this commodity under the Second Schedule.', '["net_quantity"]'::jsonb, 'LAW', '2011-04-01', '2022-03-31', 'OMITTED_LATER_VERIFY_DATE', 'Rule 5 and the Second Schedule were reportedly omitted by the 2021/2022 amendments. effective_to must be confirmed from the Gazette.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R5-001', 1);
INSERT INTO rules VALUES ('LMPC-R5-002', 1, 'active', 'Non-standard size package carries ''Not a standard pack size'' declaration', 'STANDARD_PACK_SIZE', 'LMPC2011:5 proviso', '{"source": "LMPC Rules 2011", "rule": "5 proviso", "pdf_page": 4, "text_excerpt": "a declaration that ''Not a standard pack size under the Legal Metrology (Packaged Commodities) Rules, 2011'' ... shall be made prominently"}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fn": "is_second_schedule_commodity", "args": {}}, {"not": {"fn": "standard_pack_size_ok", "args": {}}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "label.full_text", "op": "matches_regex", "value": "(?i)(not\\s+a\\s+standard\\s+pack\\s+size|non[\\s-]*standard\\s+size)"}'::jsonb, 'NON_COMPLIANT', 'Non-standard pack size without the required ''Not a standard pack size'' declaration.', '["label.full_text"]'::jsonb, 'LAW', '2011-04-01', '2012-06-30', 'WITHDRAWN_IN_TEXT', 'Proviso withdrawn w.e.f. 01.07.2012 vide GSR 748(E) dated 24.10.2011 (noted in the PDF). After withdrawal, a non-standard size is simply non-compliant under LMPC-R5-001.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R5-002', 1);
INSERT INTO rules VALUES ('LMPC-SCH2-10-001', 1, 'active', 'Edible oil/ghee declared by volume also declares equivalent mass in brackets', 'QUANTITY_DECLARATION', 'LMPC2011:Second Schedule, Sl. 10', '{"source": "LMPC Rules 2011", "rule": "Second Schedule, Sl. 10", "pdf_page": 30, "text_excerpt": "If the net quantity is declared by volume, then the equivalent quantity in terms of mass to be declared in brackets in same size of letters/numerals"}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "product.tags", "op": "contains", "value": "edible_oil_ghee"}, {"fact": "net_quantity.dimension", "op": "eq", "value": "volume"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "net_quantity.mass_equivalent", "op": "exists"}'::jsonb, 'NON_COMPLIANT', 'Edible oil declared by volume without equivalent mass in brackets.', '["net_quantity", "net_quantity.mass_equivalent"]'::jsonb, 'LAW', '2011-04-01', '2022-03-31', 'OMITTED_LATER_VERIFY_DATE', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-SCH2-10-001', 1);
INSERT INTO rules VALUES ('LMPC-R6-1a-001', 1, 'active', 'Name of manufacturer declared', 'MANDATORY_DECLARATION', 'LMPC2011:6(1)(a), 10(1)', '{"source": "LMPC Rules 2011", "rule": "6(1)(a), 10(1)", "pdf_page": 5, "text_excerpt": "the name and address of the manufacturer ... shall be mentioned"}'::jsonb, 'LABEL_AUTOMATED', 'CRITICAL', '{"all": [{"macro": "RETAIL_SCOPE"}, {"not": {"macro": "SMALL_PACKAGE_5CC"}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(a) Expl. III / 6(1)(d) 1st proviso", "when": {"fact": "product.tags", "op": "contains", "value": "food"}, "reason": "Food packages: requirement governed by food law (PFA Act 1954 in the text; now Food Safety and Standards Act, 2006 and its labelling regulations). Route to FSS rule pack."}]'::jsonb, '{"fact": "manufacturer.name", "op": "exists"}'::jsonb, 'NON_COMPLIANT', 'Manufacturer name was not detected on the package.', '["manufacturer.name"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1a-001', 1);
INSERT INTO rules VALUES ('LMPC-R6-1a-002', 1, 'active', 'Complete address of manufacturer declared', 'MANDATORY_DECLARATION', 'LMPC2011:6(1)(a), 10(1) Explanation', '{"source": "LMPC Rules 2011", "rule": "6(1)(a), 10(1) Explanation", "pdf_page": 11, "text_excerpt": "''complete address'' means ... the name of the street, number (if any) ... and either the name of the city and State ... or the Postal Index Number [PIN] Code"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"not": {"macro": "SMALL_PACKAGE_5CC"}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(a) Expl. III / 6(1)(d) 1st proviso", "when": {"fact": "product.tags", "op": "contains", "value": "food"}, "reason": "Food packages: requirement governed by food law (PFA Act 1954 in the text; now Food Safety and Standards Act, 2006 and its labelling regulations). Route to FSS rule pack."}, {"exemption_ref": "Rule 28", "when": {"fact": "registry.manufacturer_short_address_registered", "op": "eq", "value": true}, "reason": "Registered shorter address may be used (Rule 28)."}]'::jsonb, '{"all": [{"fact": "manufacturer.address.text", "op": "exists"}, {"any": [{"fact": "manufacturer.address.pin", "op": "matches_regex", "value": "^[1-9][0-9]{5}$"}, {"all": [{"fact": "manufacturer.address.city", "op": "exists"}, {"fact": "manufacturer.address.state", "op": "exists"}]}, {"all": [{"fact": "manufacturer.address.country", "op": "ne", "value": "India"}, {"fact": "manufacturer.address.city", "op": "exists"}]}]}]}'::jsonb, 'NON_COMPLIANT', 'Manufacturer address is missing or incomplete (needs city + State, or a valid 6-digit PIN).', '["manufacturer.address"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'Foreign manufacturer: city + country accepted (PIN/State are Indian concepts) — interpretation, confirm with officer.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1a-002', 1);
INSERT INTO rules VALUES ('LMPC-R6-1a-003', 1, 'active', 'Name and address of packer where packer is not the manufacturer', 'MANDATORY_DECLARATION', 'LMPC2011:6(1)(a), 10(1)', '{"source": "LMPC Rules 2011", "rule": "6(1)(a), 10(1)", "pdf_page": 5, "text_excerpt": "where the manufacturer is not the packer, the name and address of the manufacturer and packer"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "parties.packer_is_distinct", "op": "eq", "value": true, "absent_as": false}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(a) Expl. III / 6(1)(d) 1st proviso", "when": {"fact": "product.tags", "op": "contains", "value": "food"}, "reason": "Food packages: requirement governed by food law (PFA Act 1954 in the text; now Food Safety and Standards Act, 2006 and its labelling regulations). Route to FSS rule pack."}]'::jsonb, '{"all": [{"fact": "packer.name", "op": "exists"}, {"fact": "packer.address.text", "op": "exists"}]}'::jsonb, 'NON_COMPLIANT', 'Package indicates a separate packer but packer name/address was not found.', '["packer"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1a-003', 1);
INSERT INTO rules VALUES ('LMPC-R6-1a-004', 1, 'active', 'Name and address of importer on imported packages', 'MANDATORY_DECLARATION', 'LMPC2011:6(1)(a), 10(1)', '{"source": "LMPC Rules 2011", "rule": "6(1)(a), 10(1)", "pdf_page": 5, "text_excerpt": "for any imported package the name and address of the importer shall be mentioned"}'::jsonb, 'LABEL_AUTOMATED', 'CRITICAL', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "product.is_imported", "op": "eq", "value": true}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"fact": "importer.name", "op": "exists"}, {"fact": "importer.address.text", "op": "exists"}]}'::jsonb, 'NON_COMPLIANT', 'Imported package without importer name and address.', '["importer"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1a-004', 1);
INSERT INTO rules VALUES ('LMPC-R10-1-001', 1, 'active', 'Foreign-made commodity packed in India shows Indian packer/importer on PDP', 'MANDATORY_DECLARATION', 'LMPC2011:10(1) second proviso', '{"source": "LMPC Rules 2011", "rule": "10(1) second proviso", "pdf_page": 11, "text_excerpt": "where any commodity manufactured outside India is packed in India, the package shall also contain on the principal display panel the name and complete address of the packer or the importer in India"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "product.country_of_manufacture", "op": "ne", "value": "India"}, {"fact": "product.packed_in_india", "op": "eq", "value": true, "absent_as": false}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"any": [{"all": [{"fact": "packer.name", "op": "exists"}, {"fact": "packer.address.country", "op": "eq", "value": "India"}]}, {"all": [{"fact": "importer.name", "op": "exists"}, {"fact": "importer.address.country", "op": "eq", "value": "India"}]}]}'::jsonb, 'NON_COMPLIANT', 'Commodity made abroad and packed in India lacks Indian packer/importer name and address.', '["packer", "importer"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R10-1-001', 1);
INSERT INTO rules VALUES ('LMPC-R10-1-002', 1, 'active', 'Packages <=5 cc carry an identifying mark of manufacturer/packer/importer', 'MANDATORY_DECLARATION', 'LMPC2011:10(1) first proviso, 12(7)', '{"source": "LMPC Rules 2011", "rule": "10(1) first proviso, 12(7)", "pdf_page": 11, "text_excerpt": "for packages of capacity 5 cubic cm or less, it shall be a sufficient compliance ... if a mark or inscription which would enable the consumer to identify the manufacturer or packer or the importer ... is made"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"macro": "SMALL_PACKAGE_5CC"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"any": [{"fact": "manufacturer.identifying_mark", "op": "exists"}, {"fact": "manufacturer.name", "op": "exists"}]}'::jsonb, 'NON_COMPLIANT', 'Small package (<=5 cc) has no mark identifying the manufacturer/packer/importer.', '["manufacturer.identifying_mark"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R10-1-002', 1);
INSERT INTO rules VALUES ('LMPC-R10-2-001', 1, 'active', 'Party name is the actual corporate / registered business name', 'MANDATORY_DECLARATION', 'LMPC2011:10(2)', '{"source": "LMPC Rules 2011", "rule": "10(2)", "pdf_page": 11, "text_excerpt": "The name of the manufacturer or packer or importer shall be the actual corporate name, or if not incorporated, the name under which the business is conducted"}'::jsonb, 'EXTERNAL_LOOKUP', 'MEDIUM', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(a) Expl. III / 6(1)(d) 1st proviso", "when": {"fact": "product.tags", "op": "contains", "value": "food"}, "reason": "Food packages: requirement governed by food law (PFA Act 1954 in the text; now Food Safety and Standards Act, 2006 and its labelling regulations). Route to FSS rule pack."}]'::jsonb, '{"fact": "registry.corporate_name_matches", "op": "eq", "value": true}'::jsonb, 'NON_COMPLIANT', 'Declared name does not match the registered corporate/business name.', '["manufacturer.name"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'Needs MCA / LM registration lookup; without it the rule returns REQUIRES_VERIFICATION.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R10-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R6-1a-EXPL1', 1, 'active', 'Name without ''manufactured by''/''packed by'' is presumed to be the manufacturer', 'LIABILITY_INFERENCE', 'LMPC2011:6(1)(a) Explanation I & II', '{"source": "LMPC Rules 2011", "rule": "6(1)(a) Explanation I & II", "pdf_page": 5, "text_excerpt": "If any name and address of a company is mentioned on the label without any qualifying words ''manufactured by'' or ''packed by'', it shall be presumed that such name and address shall be that of the manufacturer"}'::jsonb, 'LABEL_AUTOMATED', 'INFO', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "manufacturer.name", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "manufacturer.role_qualified", "op": "eq", "value": true}'::jsonb, 'OBSERVATION', 'No ''Manufactured by''/''Packed by''/''Marketed by'' qualifier — the first named party is presumed manufacturer for liability.', '["manufacturer.name"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1a-EXPL1', 1);
INSERT INTO rules VALUES ('LMPC-R6-1b-001', 1, 'active', 'Common or generic name of the commodity declared', 'MANDATORY_DECLARATION', 'LMPC2011:6(1)(b)', '{"source": "LMPC Rules 2011", "rule": "6(1)(b)", "pdf_page": 5, "text_excerpt": "The common or generic names of the commodity contained in the package"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "product.common_name", "op": "exists"}'::jsonb, 'NON_COMPLIANT', 'Common/generic name of the commodity was not detected.', '["product.common_name"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1b-001', 1);
INSERT INTO rules VALUES ('LMPC-R6-1b-002', 1, 'active', 'Multi-product package names each product with its number or quantity', 'MANDATORY_DECLARATION', 'LMPC2011:6(1)(b)', '{"source": "LMPC Rules 2011", "rule": "6(1)(b)", "pdf_page": 5, "text_excerpt": "in case of packages with more than one product, the name and number or quantity of each product shall be mentioned"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "package.is_multi_product", "op": "eq", "value": true, "absent_as": false}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"fact": "package.components", "op": "exists"}, {"each": "package.components", "require": {"all": [{"fact": "$item.name", "op": "exists"}, {"fact": "$item.quantity", "op": "exists"}]}}]}'::jsonb, 'NON_COMPLIANT', 'Multi-product package does not state name and number/quantity of each product.', '["package.components"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1b-002', 1);
INSERT INTO rules VALUES ('LMPC-R6-1c-001', 1, 'active', 'Net quantity declared in standard unit or by number', 'QUANTITY_DECLARATION', 'LMPC2011:6(1)(c)', '{"source": "LMPC Rules 2011", "rule": "6(1)(c)", "pdf_page": 5, "text_excerpt": "The net quantity, in terms of the standard unit of weight or measure ... or ... the number of the commodity contained in the package"}'::jsonb, 'LABEL_AUTOMATED', 'CRITICAL', '{"all": [{"macro": "RETAIL_SCOPE"}, {"not": {"macro": "SMALL_PACKAGE_5CC"}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"fact": "net_quantity.value", "op": "exists"}, {"fact": "net_quantity.unit", "op": "exists"}, {"fact": "net_quantity.dimension", "op": "in", "value": ["mass", "volume", "length", "area", "number"]}]}'::jsonb, 'NON_COMPLIANT', 'Net quantity declaration not detected or not in a recognised standard unit.', '["net_quantity"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1c-001', 1);
INSERT INTO rules VALUES ('LMPC-R12-7-001', 1, 'active', 'Packages <=5 cc: quantity on tag/card/tape that cannot be removed without opening', 'QUANTITY_DECLARATION', 'LMPC2011:12(7)', '{"source": "LMPC Rules 2011", "rule": "12(7)", "pdf_page": 13, "text_excerpt": "the declaration of quantity shall be made on a tag, card, tape, or any other similar device affixed to the container in such a manner that it cannot be removed without opening the container"}'::jsonb, 'MANUAL_INSPECTION', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"macro": "SMALL_PACKAGE_5CC"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"fact": "net_quantity.value", "op": "exists"}, {"fact": "label.quantity_tag_tamper_evident", "op": "eq", "value": true}]}'::jsonb, 'NON_COMPLIANT', 'Quantity on <=5 cc package is missing or not on a tamper-evident tag/card/tape.', '["net_quantity"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R12-7-001', 1);
INSERT INTO rules VALUES ('LMPC-R11-2-001', 1, 'active', '''When packed'' qualifier used only for Third Schedule commodities', 'QUANTITY_DECLARATION', 'LMPC2011:11(2)-(4) + Third Schedule', '{"source": "LMPC Rules 2011", "rule": "11(2)-(4) + Third Schedule", "pdf_page": 12, "text_excerpt": "the declaration of quantity on such package shall not be qualified by the words ''when packed'' or the like ... [except] as specified in the Third Schedule"}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.text", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"any": [{"not": {"fact": "net_quantity.text", "op": "matches_regex", "value": "(?i)when\\s+packed|at\\s+the\\s+time\\s+of\\s+packing"}}, {"fact": "product.tags", "op": "contains_any", "value": ["soap", "lotion", "cream_non_dairy"]}]}'::jsonb, 'NON_COMPLIANT', 'Quantity is qualified by ''when packed'' but the commodity is not in the Third Schedule (soaps, lotions, non-dairy cream).', '["net_quantity.text"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R11-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R12-2-001', 1, 'active', 'Quantity expressed in the correct kind of unit (mass/volume/length/area/number)', 'QUANTITY_DECLARATION', 'LMPC2011:12(2) + Fourth Schedule', '{"source": "LMPC Rules 2011", "rule": "12(2) + Fourth Schedule", "pdf_page": 12, "text_excerpt": "the declaration of quantity shall be in terms of the unit of (a) mass, if the commodity is solid, semi-solid, viscous or a mixture of solid and liquid; ... (d) volume, if the commodity is liquid"}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.dimension", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "unit_dimension_allowed", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Quantity is declared in a unit type not permitted for this commodity (Rule 12(2) / Fourth Schedule).', '["net_quantity", "product.physical_state"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R12-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R12-6-001', 1, 'active', 'Quantity declaration has no misleading qualifiers (''about'', ''minimum'', ''approx.'' ...)', 'QUANTITY_DECLARATION', 'LMPC2011:12(6)', '{"source": "LMPC Rules 2011", "rule": "12(6)", "pdf_page": 13, "text_excerpt": "words or expressions like-''minimum'', ''not less than'', ''average'', ''about'', approximately'' or other words of a similar nature"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.text", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "no_misleading_quantity_terms", "args": {"table_version": "2011-04-01"}}'::jsonb, 'NON_COMPLIANT', 'Net quantity declaration contains a misleading qualifier.', '["net_quantity.text"]'::jsonb, 'LAW', '2011-04-01', '2012-06-30', 'AMENDED_IN_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R12-6-001', 1);
INSERT INTO rules VALUES ('LMPC-R12-6-001', 2, 'active', 'Quantity declaration has no word of any sort that may mislead as to quantity', 'QUANTITY_DECLARATION', 'LMPC2011:12(6) as amended', '{"source": "LMPC Rules 2011", "rule": "12(6) as amended", "pdf_page": 13, "text_excerpt": "The declaration of quantity under these Rules shall not contain any word or expression of any sort, whatsoever, which tends to create or likely to create an exaggerated, misleading or inadequate expression"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.text", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "no_misleading_quantity_terms", "args": {"table_version": "2012-07-01"}}'::jsonb, 'NON_COMPLIANT', 'Net quantity declaration contains a word that may mislead as to quantity.', '["net_quantity.text"]'::jsonb, 'LAW', '2012-07-01', NULL, 'AMENDED_BY_GSR_748E_2011', 'Known terms -> NON_COMPLIANT; any other unexplained word adjacent to the quantity -> REQUIRES_VERIFICATION.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R12-6-001', 2);
INSERT INTO rules VALUES ('LMPC-R13-2-001', 1, 'active', 'Correct unit for the magnitude (g below 1 kg, kg from 1 kg; ml/l; cm/m; dm2/m2)', 'QUANTITY_DECLARATION', 'LMPC2011:13(2), 13(3)', '{"source": "LMPC Rules 2011", "rule": "13(2), 13(3)", "pdf_page": 13, "text_excerpt": "When expressing a quantity less than (a) one kilogram, the unit of weight shall be the gram ... equal to or more than (a) one kilogram, the unit of weight shall be the kilogram"}'::jsonb, 'LABEL_AUTOMATED', 'LOW', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.dimension", "op": "in", "value": ["mass", "volume", "length", "area"]}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "unit_convention_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Unit does not follow Rule 13 conventions (e.g. ''1500 g'' should be ''1.5 kg''; ''0.5 kg'' should be ''500 g'').', '["net_quantity"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R13-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R13-4-001', 1, 'active', 'No ''dozen'', ''score'', ''gross'' or ''great gross''', 'QUANTITY_DECLARATION', 'LMPC2011:13(4)', '{"source": "LMPC Rules 2011", "rule": "13(4)", "pdf_page": 14, "text_excerpt": "No number called the dozen, score, gross, great gross or the like shall be specified or indicated on any package."}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"not": {"fact": "label.full_text", "op": "matches_regex", "value": "(?i)\\b(dozen|score|great\\s+gross|gross(?!\\s*(wt|weight)))\\b"}}'::jsonb, 'NON_COMPLIANT', 'Package uses dozen/score/gross style numbers.', '["label.full_text"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'Regex ignores ''gross wt/weight''. ''score'' may appear in marketing copy — expect some false positives; restrict to declaration panel text in production.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R13-4-001', 1);
INSERT INTO rules VALUES ('LMPC-R13-5-001', 1, 'active', 'Net quantity uses SI units only', 'QUANTITY_DECLARATION', 'LMPC2011:13(5)(i)', '{"source": "LMPC Rules 2011", "rule": "13(5)(i)", "pdf_page": 14, "text_excerpt": "No system of units other than the International System of Units shall be used in furnishing the net quantity"}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.text", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "si_units_only", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Net quantity declaration uses non-SI units (oz, lb, fl oz, inch ...).', '["net_quantity.text"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R13-5-001', 1);
INSERT INTO rules VALUES ('LMPC-R13-5-002', 1, 'active', 'Items sold by number use symbol N or U', 'QUANTITY_DECLARATION', 'LMPC2011:13(5)(ii)', '{"source": "LMPC Rules 2011", "rule": "13(5)(ii)", "pdf_page": 14, "text_excerpt": "For items sold by number the symbol should be N or U."}'::jsonb, 'LABEL_AUTOMATED', 'LOW', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.dimension", "op": "eq", "value": "number"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "net_quantity.unit", "op": "in", "value": ["N", "U"]}'::jsonb, 'NON_COMPLIANT', 'Count declared without the N or U symbol.', '["net_quantity"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AMENDED_LATER_VERIFY', 'Later amendment reportedly allows number/unit/piece/pair/set etc. Add version 2 once the Gazette date is confirmed.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R13-5-002', 1);
INSERT INTO rules VALUES ('LMPC-R6-1d-001', 1, 'active', 'Month and year of manufacture / pre-packing / import declared', 'DATE_DECLARATION', 'LMPC2011:6(1)(d)', '{"source": "LMPC Rules 2011", "rule": "6(1)(d)", "pdf_page": 5, "text_excerpt": "The month and year in which the commodity is manufactured or pre-packed or imported shall be mentioned in the package."}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(a) Expl. III / 6(1)(d) 1st proviso", "when": {"fact": "product.tags", "op": "contains", "value": "food"}, "reason": "Food packages: requirement governed by food law (PFA Act 1954 in the text; now Food Safety and Standards Act, 2006 and its labelling regulations). Route to FSS rule pack."}, {"exemption_ref": "6(1)(d) 2nd proviso", "when": {"fact": "product.tags", "op": "contains", "value": "seeds_certified"}, "reason": "Seeds labelled and certified under the Seeds Act, 1966."}, {"exemption_ref": "6(1)(d) 4th proviso", "when": {"fact": "product.tags", "op": "contains", "value": "cosmetic"}, "reason": "Cosmetics: Drugs and Cosmetics Rules, 1945 apply."}, {"exemption_ref": "6(1)(g)(A)(i)", "when": {"fact": "product.tags", "op": "contains_any", "value": ["bidi", "incense_sticks"]}, "reason": "Bidis and incense sticks exempt from month/year declaration."}, {"exemption_ref": "6(1)(g)(A)(ii)", "when": {"fact": "product.tags", "op": "contains", "value": "lpg_domestic_psu_14_2_or_5kg"}, "reason": "Domestic LPG cylinders 14.2 kg / 5 kg bottled by a PSU."}]'::jsonb, '{"all": [{"fact": "date_of_manufacture.month", "op": "exists"}, {"fact": "date_of_manufacture.year", "op": "exists"}, {"fact": "date_of_manufacture.month", "op": "between", "value": [1, 12]}]}'::jsonb, 'NON_COMPLIANT', 'Month and year of manufacture/pre-packing/import not detected.', '["date_of_manufacture"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AMENDED_LATER_VERIFY', 'Later amendments reportedly changed which date must be declared (manufacture vs import) — add version 2 after verification.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1d-001', 1);
INSERT INTO rules VALUES ('LMPC-R6-1d-002', 1, 'active', 'Month/year not applied by rubber stamp (proviso permitting it withdrawn)', 'DATE_DECLARATION', 'LMPC2011:6(1)(d) 3rd proviso (withdrawn)', '{"source": "LMPC Rules 2011", "rule": "6(1)(d) 3rd proviso (withdrawn)", "pdf_page": 6, "text_excerpt": "a manufacturer may indicate the month and year using a rubber stamp without overwriting. * Provisio will stand withdrawn wef 01.07.2012"}'::jsonb, 'VISION_AUTOMATED', 'LOW', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "date_of_manufacture.month", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(a) Expl. III / 6(1)(d) 1st proviso", "when": {"fact": "product.tags", "op": "contains", "value": "food"}, "reason": "Food packages: requirement governed by food law (PFA Act 1954 in the text; now Food Safety and Standards Act, 2006 and its labelling regulations). Route to FSS rule pack."}, {"exemption_ref": "6(1)(d) 2nd proviso", "when": {"fact": "product.tags", "op": "contains", "value": "seeds_certified"}, "reason": "Seeds labelled and certified under the Seeds Act, 1966."}, {"exemption_ref": "6(1)(d) 4th proviso", "when": {"fact": "product.tags", "op": "contains", "value": "cosmetic"}, "reason": "Cosmetics: Drugs and Cosmetics Rules, 1945 apply."}, {"exemption_ref": "6(1)(g)(A)(i)", "when": {"fact": "product.tags", "op": "contains_any", "value": ["bidi", "incense_sticks"]}, "reason": "Bidis and incense sticks exempt from month/year declaration."}, {"exemption_ref": "6(1)(g)(A)(ii)", "when": {"fact": "product.tags", "op": "contains", "value": "lpg_domestic_psu_14_2_or_5kg"}, "reason": "Domestic LPG cylinders 14.2 kg / 5 kg bottled by a PSU."}]'::jsonb, '{"fact": "date_of_manufacture.print_method", "op": "ne", "value": "rubber_stamp"}'::jsonb, 'REQUIRES_VERIFICATION', 'Date appears to be rubber-stamped; express permission for this was withdrawn from 01.07.2012.', '["date_of_manufacture"]'::jsonb, 'LAW', '2012-07-01', NULL, 'INTERPRETATION_FLAG', 'Withdrawal of a permissive proviso is not an explicit prohibition — so the engine flags for officer review rather than failing.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1d-002', 1);
INSERT INTO rules VALUES ('LMPC-R6-1e-001', 1, 'active', 'Retail sale price (MRP) declared', 'PRICE_DECLARATION', 'LMPC2011:6(1)(e)', '{"source": "LMPC Rules 2011", "rule": "6(1)(e)", "pdf_page": 6, "text_excerpt": "the retail sale price of the package"}'::jsonb, 'LABEL_AUTOMATED', 'CRITICAL', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(g)(C)(i)", "when": {"fact": "product.tags", "op": "contains", "value": "bidi"}, "reason": "No retail sale price required on bidi packages."}, {"exemption_ref": "6(1)(g)(C)(ii)", "when": {"fact": "product.tags", "op": "contains", "value": "lpg_domestic_apm"}, "reason": "Domestic LPG cylinder under Administered Price Mechanism."}, {"exemption_ref": "6(1)(e) proviso", "when": {"all": [{"fact": "product.tags", "op": "contains", "value": "alcoholic_beverage"}, {"fact": "other_law.state_excise_prescribes_rsp", "op": "eq", "value": true}]}, "reason": "Alcoholic beverages: State Excise law governs RSP where it provides for it."}]'::jsonb, '{"all": [{"fact": "mrp.value", "op": "exists"}]}'::jsonb, 'NON_COMPLIANT', 'Retail sale price (MRP) not detected.', '["mrp"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'For alcoholic beverages with other_law.state_excise_prescribes_rsp unknown, the exemption evaluates UNKNOWN -> a missing MRP returns REQUIRES_VERIFICATION instead of NON_COMPLIANT.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1e-001', 1);
INSERT INTO rules VALUES ('LMPC-R2m-001', 1, 'active', 'MRP printed in the prescribed form (''MRP Rs ... inclusive of all taxes'')', 'PRICE_DECLARATION', 'LMPC2011:2(m), 8(2)', '{"source": "LMPC Rules 2011", "rule": "2(m), 8(2)", "pdf_page": 3, "text_excerpt": "''Maximum or Max. retail price Rs/ .......inclusive of all taxes or in the form MRP Rs/ .........incl., of all taxes"}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "mrp.text", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(g)(C)(i)", "when": {"fact": "product.tags", "op": "contains", "value": "bidi"}, "reason": "No retail sale price required on bidi packages."}, {"exemption_ref": "6(1)(g)(C)(ii)", "when": {"fact": "product.tags", "op": "contains", "value": "lpg_domestic_apm"}, "reason": "Domestic LPG cylinder under Administered Price Mechanism."}, {"exemption_ref": "6(1)(e) proviso", "when": {"all": [{"fact": "product.tags", "op": "contains", "value": "alcoholic_beverage"}, {"fact": "other_law.state_excise_prescribes_rsp", "op": "eq", "value": true}]}, "reason": "Alcoholic beverages: State Excise law governs RSP where it provides for it."}]'::jsonb, '{"any": [{"fn": "mrp_format_ok", "args": {}}, {"all": [{"fact": "product.tags", "op": "contains", "value": "soft_drink_returnable_bottle"}, {"fact": "mrp.on_crown_cap_or_bottle", "op": "eq", "value": true, "absent_as": false}, {"fn": "mrp_format_ok", "args": {"returnable": true}}]}]}'::jsonb, 'NON_COMPLIANT', 'MRP is not in the prescribed form (missing ''inclusive of all taxes'' or MRP/Rs wording).', '["mrp.text"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AMENDED_LATER_VERIFY', 'Rule 8(2): returnable soft-drink bottles may show just ''MRP Rs....'' on crown cap/bottle. Currency symbol ₹/INR accepted as policy.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R2m-001', 1);
INSERT INTO rules VALUES ('LMPC-R2m-002', 1, 'active', 'MRP rounded as prescribed (paise part only 00 or 50)', 'PRICE_DECLARATION', 'LMPC2011:2(m)', '{"source": "LMPC Rules 2011", "rule": "2(m)", "pdf_page": 3, "text_excerpt": "fraction of less than fifty paisa to be rounded off to the preceding rupees and fraction of above 50 paise and up to 95 paise to the rounded off to fifty paise"}'::jsonb, 'LABEL_AUTOMATED', 'LOW', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "mrp.value", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "6(1)(g)(C)(i)", "when": {"fact": "product.tags", "op": "contains", "value": "bidi"}, "reason": "No retail sale price required on bidi packages."}, {"exemption_ref": "6(1)(g)(C)(ii)", "when": {"fact": "product.tags", "op": "contains", "value": "lpg_domestic_apm"}, "reason": "Domestic LPG cylinder under Administered Price Mechanism."}, {"exemption_ref": "6(1)(e) proviso", "when": {"all": [{"fact": "product.tags", "op": "contains", "value": "alcoholic_beverage"}, {"fact": "other_law.state_excise_prescribes_rsp", "op": "eq", "value": true}]}, "reason": "Alcoholic beverages: State Excise law governs RSP where it provides for it."}]'::jsonb, '{"fn": "mrp_rounding_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'MRP paise part is not rounded to 00 or 50 as required by Rule 2(m).', '["mrp.value"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AMENDED_LATER_VERIFY', 'Text is silent on fractions above 95 paise; engine treats .00 and .50 as the only valid endings.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R2m-002', 1);
INSERT INTO rules VALUES ('LMPC-R6-3-001', 1, 'active', 'No sticker used to alter or make a mandatory declaration', 'LABEL_INTEGRITY', 'LMPC2011:6(3)', '{"source": "LMPC Rules 2011", "rule": "6(3)", "pdf_page": 7, "text_excerpt": "It shall not be permissible to affix individual stickers on the package for altering or making declaration required under these rules"}'::jsonb, 'VISION_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "label.stickers", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"each": "label.stickers", "require": {"any": [{"fact": "$item.covers_mandatory_declaration", "op": "eq", "value": false}, {"fact": "$item.type", "op": "eq", "value": "mrp_reduction"}]}}'::jsonb, 'NON_COMPLIANT', 'A sticker is used to make or alter a mandatory declaration.', '["label.stickers"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-3-001', 1);
INSERT INTO rules VALUES ('LMPC-R6-3-002', 1, 'active', 'MRP-reduction sticker shows a LOWER MRP and does not cover the original MRP', 'LABEL_INTEGRITY', 'LMPC2011:6(3) proviso', '{"source": "LMPC Rules 2011", "rule": "6(3) proviso", "pdf_page": 7, "text_excerpt": "for reducing the Maximum Retail Price (MRP), a sticker with the revised lower MRP (inclusive of all taxes) may be affixed and the same shall not cover the MRP declaration made by the manufacturer"}'::jsonb, 'VISION_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fn": "has_sticker_type", "args": {"type": "mrp_reduction"}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "mrp_reduction_stickers_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'MRP sticker is higher than the printed MRP or hides the original MRP.', '["label.stickers", "mrp"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-3-002', 1);
INSERT INTO rules VALUES ('LMPC-R18-5-001', 1, 'active', 'Printed MRP not obliterated, smudged or altered', 'LABEL_INTEGRITY', 'LMPC2011:18(5), 18(6)', '{"source": "LMPC Rules 2011", "rule": "18(5), 18(6)", "pdf_page": 17, "text_excerpt": "No wholesale dealer or retail dealer or other person shall obliterate, smudge or alter the retail sale price"}'::jsonb, 'VISION_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "mrp.text", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "mrp.tamper_detected", "op": "eq", "value": false}'::jsonb, 'REQUIRES_VERIFICATION', 'MRP area shows signs of obliteration/alteration.', '["mrp"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'Vision tamper signal is probabilistic -> officer confirms.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R18-5-001', 1);
INSERT INTO rules VALUES ('LMPC-R18-2-001', 1, 'active', 'Sale not above retail sale price', 'TRADE_PRACTICE', 'LMPC2011:18(2)', '{"source": "LMPC Rules 2011", "rule": "18(2)", "pdf_page": 16, "text_excerpt": "No retail dealer or other person ... shall make any sale of any commodity in packed form at a price exceeding the retail sale price"}'::jsonb, 'MANUAL_INPUT', 'CRITICAL', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "transaction.selling_price", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "selling_price_within_mrp", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Commodity sold above the MRP.', '["transaction.selling_price", "mrp.value"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R18-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R6-1f-001', 1, 'active', 'Dimensions declared where size of the commodity is relevant', 'DIMENSION_DECLARATION', 'LMPC2011:6(1)(f), 12(4), 15', '{"source": "LMPC Rules 2011", "rule": "6(1)(f), 12(4), 15", "pdf_page": 6, "text_excerpt": "Where the sizes of the commodity contained in the package are relevant, the dimensions of the commodity ... shall be mentioned"}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "product.tags", "op": "contains_any", "value": ["size_relevant", "price_depends_on_dimensions"]}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "dimensions.text", "op": "exists"}'::jsonb, 'NON_COMPLIANT', 'Size-relevant commodity without dimension declaration.', '["dimensions"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'Whether size is ''relevant'' is a classification decision — keep it as an explicit tag set by the classifier or officer.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-1f-001', 1);
INSERT INTO rules VALUES ('LMPC-R14-001', 1, 'active', 'Textile goods declare number and finished dimensions', 'DIMENSION_DECLARATION', 'LMPC2011:14', '{"source": "LMPC Rules 2011", "rule": "14", "pdf_page": 14, "text_excerpt": "Where a package contains commodities like bed-sheets, hemmed fabric materials, dhoties, sarees, napkins, pillow-covers, towels, table cloths ... the number and the dimensions of finished size ... shall also be declared"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fn": "has_any_tag_from_table", "args": {"table": "rule14_textile_commodities"}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"fact": "dimensions.item_count", "op": "exists"}, {"fact": "dimensions.text", "op": "exists"}]}'::jsonb, 'NON_COMPLIANT', 'Textile package without number of pieces and finished dimensions.', '["dimensions"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R14-001', 1);
INSERT INTO rules VALUES ('LMPC-R14-002', 1, 'active', 'Textile set with pieces of different sizes declares dimensions and price of each piece', 'DIMENSION_DECLARATION', 'LMPC2011:14 first proviso', '{"source": "LMPC Rules 2011", "rule": "14 first proviso", "pdf_page": 14, "text_excerpt": "where the package contains more than one piece of different dimensions, the package shall also contain a declaration as to the dimensions and the retail sale price of each such piece"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fn": "has_any_tag_from_table", "args": {"table": "rule14_textile_commodities"}}, {"fact": "dimensions.pieces_differ", "op": "eq", "value": true, "absent_as": false}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"fact": "dimensions.pieces", "op": "exists"}, {"each": "dimensions.pieces", "require": {"all": [{"fact": "$item.dimensions", "op": "exists"}, {"fact": "$item.rsp", "op": "exists"}]}}]}'::jsonb, 'NON_COMPLIANT', 'Mixed-size textile set does not state dimensions and price for each piece.', '["dimensions.pieces"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R14-002', 1);
INSERT INTO rules VALUES ('LMPC-R14-003', 1, 'active', 'Each individual textile piece marked with dimensions and price', 'DIMENSION_DECLARATION', 'LMPC2011:14 second proviso', '{"source": "LMPC Rules 2011", "rule": "14 second proviso", "pdf_page": 14, "text_excerpt": "the dimensions of the commodities and the sale price thereof shall also be marked on each individual piece"}'::jsonb, 'MANUAL_INSPECTION', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fn": "has_any_tag_from_table", "args": {"table": "rule14_textile_commodities"}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "inspection.each_piece_marked", "op": "eq", "value": true}'::jsonb, 'NON_COMPLIANT', 'Individual pieces are not marked with dimensions and price.', '[]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R14-003', 1);
INSERT INTO rules VALUES ('LMPC-R16-001', 1, 'active', 'Sheet products declare number of usable sheets and sheet dimensions', 'DIMENSION_DECLARATION', 'LMPC2011:16', '{"source": "LMPC Rules 2011", "rule": "16", "pdf_page": 15, "text_excerpt": "In the case of a package containing sheets like aluminum foil, facial tissues, waxed paper, toilet paper ... a statement as to the number of usable sheets ... and the dimensions of each such sheet"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fn": "has_any_tag_from_table", "args": {"table": "rule16_sheet_commodities"}}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"fact": "sheets.count", "op": "exists"}, {"fact": "sheets.dimensions", "op": "exists"}]}'::jsonb, 'NON_COMPLIANT', 'Sheet product without number of usable sheets and dimensions of each sheet.', '["sheets"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R16-001', 1);
INSERT INTO rules VALUES ('LMPC-R17-001', 1, 'active', 'Container-type commodities declare count followed by dimensions', 'DIMENSION_DECLARATION', 'LMPC2011:17(i)-(iii)', '{"source": "LMPC Rules 2011", "rule": "17(i)-(iii)", "pdf_page": 15, "text_excerpt": "for bag-type commodities, the number of bags ... followed by linear dimensions; ... square, oblong ... length, width, and if required, depth; ... circular ... diameter"}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "product.tags", "op": "contains_any", "value": ["container_bag", "container_rectangular", "container_round"]}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "container_declaration_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Container-type commodity lacks count and the dimensions required for its shape.', '["containers"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R17-001', 1);
INSERT INTO rules VALUES ('LMPC-R17-002', 1, 'active', 'Capacity claims of containers included in the quantity declaration', 'DIMENSION_DECLARATION', 'LMPC2011:17(iv)', '{"source": "LMPC Rules 2011", "rule": "17(iv)", "pdf_page": 15, "text_excerpt": "when the use of a container is related by label references ... to the capability of the container to hold a specific quantity ... such references shall be included in the declaration of quantity"}'::jsonb, 'MANUAL_INSPECTION', 'LOW', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "containers.label_mentions_capacity", "op": "eq", "value": true, "absent_as": false}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "containers.capacity_in_quantity_declaration", "op": "eq", "value": true}'::jsonb, 'NON_COMPLIANT', 'Capacity reference not included in the quantity declaration.', '["containers"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R17-002', 1);
INSERT INTO rules VALUES ('LMPC-R6-2-001', 1, 'active', 'Consumer complaint contact: name, address and telephone number', 'CONSUMER_CARE', 'LMPC2011:6(2)', '{"source": "LMPC Rules 2011", "rule": "6(2)", "pdf_page": 7, "text_excerpt": "Every package shall bear the name, address, telephone number, e mail address, if available, of the person who can be or the office which can be, contacted, in case of consumer complaints."}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"any": [{"fact": "consumer_care.name", "op": "exists"}, {"fact": "consumer_care.designation", "op": "exists"}]}, {"fact": "consumer_care.address", "op": "exists"}, {"fact": "consumer_care.phone", "op": "matches_regex", "value": "^[+0-9()\\-\\s]{8,20}$"}]}'::jsonb, 'NON_COMPLIANT', 'Consumer-care contact (name/office, address and telephone) not fully declared.', '["consumer_care"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AMENDED_LATER_VERIFY', '2011 text read as: e-mail optional (''if available''). Later amendment reportedly made e-mail mandatory — see draft LMPC-R6-2-001 v2.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R6-2-001', 2, 'draft', 'Consumer complaint contact incl. e-mail address', 'CONSUMER_CARE', 'LMPC2011:6(2) as amended', '{"source": "LMPC Rules 2011", "rule": "6(2) as amended", "pdf_page": 7, "text_excerpt": "[amended text to be pasted from Gazette]"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"all": [{"any": [{"fact": "consumer_care.name", "op": "exists"}, {"fact": "consumer_care.designation", "op": "exists"}]}, {"fact": "consumer_care.address", "op": "exists"}, {"fact": "consumer_care.phone", "op": "matches_regex", "value": "^[+0-9()\\-\\s]{8,20}$"}, {"fact": "consumer_care.email", "op": "matches_regex", "value": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"}]}'::jsonb, 'NON_COMPLIANT', 'Consumer-care contact incomplete (name/office, address, telephone, e-mail).', '["consumer_care"]'::jsonb, 'LAW', '2018-01-01', NULL, 'DRAFT_PENDING_GAZETTE_VERIFICATION', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-2-001', 2);
INSERT INTO rules VALUES ('LMPC-R6-5-001', 1, 'active', 'Multi-unit single commodity: declarations on main package with info about accompanying packages', 'MANDATORY_DECLARATION', 'LMPC2011:6(5)', '{"source": "LMPC Rules 2011", "rule": "6(5)", "pdf_page": 7, "text_excerpt": "the declaration ... shall appear on the main package and such package shall also carry information about the other accompanying packages"}'::jsonb, 'MANUAL_INSPECTION', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "package.is_component_set", "op": "eq", "value": true, "absent_as": false}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"any": [{"fact": "package.main_package_lists_components", "op": "eq", "value": true}, {"fact": "package.each_component_labelled_and_main_intimates", "op": "eq", "value": true}]}'::jsonb, 'NON_COMPLIANT', 'Component set does not carry required declarations/intimation on the main package.', '[]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R6-5-001', 1);
INSERT INTO rules VALUES ('LMPC-R7-2-001', 1, 'active', 'Numeral height meets Table-I (quantity by weight/volume)', 'LEGIBILITY', 'LMPC2011:7(2)(i) Table-I', '{"source": "LMPC Rules 2011", "rule": "7(2)(i) Table-I", "pdf_page": 8, "text_excerpt": "[Table summary] Up to 200 g/ml: 1 mm (2 mm if blown/embossed); above 200 up to 500: 2 mm (4); above 500: 4 mm (6)"}'::jsonb, 'MEASUREMENT_REQUIRED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.dimension", "op": "in", "value": ["mass", "volume"]}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "7(4)", "when": {"fact": "other_law.governs_label_size", "op": "eq", "value": true, "absent_as": false}, "reason": "Same information required by another law (e.g. food, drugs, cosmetics, medical devices) — Rule 7(1)-(3) not applied."}]'::jsonb, '{"fn": "numeral_height_ok", "args": {"table": "rule7_table1_numeral_height_weight_volume"}}'::jsonb, 'NON_COMPLIANT', 'Numerals in the declaration are smaller than the Table-I minimum.', '["label.numeral_height_mm"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'Needs physical scale: derive mm from a known package dimension or a reference card in the photo. Without scale -> REQUIRES_VERIFICATION. Table amended later — verify.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R7-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R7-2-002', 1, 'active', 'Numeral height meets Table-II (quantity by length/area/number)', 'LEGIBILITY', 'LMPC2011:7(2)(ii) Table-II', '{"source": "LMPC Rules 2011", "rule": "7(2)(ii) Table-II", "pdf_page": 9, "text_excerpt": "[Table summary] PDP up to 100 cm2: 1 mm (2); above 100 up to 500: 2 (4); above 500 up to 2500: 4 (6); above 2500: 6 (6)"}'::jsonb, 'MEASUREMENT_REQUIRED', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.dimension", "op": "in", "value": ["length", "area", "number"]}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "7(4)", "when": {"fact": "other_law.governs_label_size", "op": "eq", "value": true, "absent_as": false}, "reason": "Same information required by another law (e.g. food, drugs, cosmetics, medical devices) — Rule 7(1)-(3) not applied."}]'::jsonb, '{"fn": "numeral_height_ok", "args": {"table": "rule7_table2_numeral_height_length_area_number"}}'::jsonb, 'NON_COMPLIANT', 'Numerals in the declaration are smaller than the Table-II minimum.', '["label.numeral_height_mm", "label.pdp_area_cm2"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R7-2-002', 1);
INSERT INTO rules VALUES ('LMPC-R7-3-001', 1, 'active', 'Letter height >= 1 mm (>= 2 mm if blown/embossed) and width >= 1/3 height', 'LEGIBILITY', 'LMPC2011:7(3)', '{"source": "LMPC Rules 2011", "rule": "7(3)", "pdf_page": 8, "text_excerpt": "The height of letters in the declaration shall not be less than 1 mm height and when blown, formed, molded, embossed or perforated, the height of letters shall not be less than 2 mm. Provided that the width of the letter or numeral shall not be less than one third of its height"}'::jsonb, 'MEASUREMENT_REQUIRED', 'LOW', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "7(4)", "when": {"fact": "other_law.governs_label_size", "op": "eq", "value": true, "absent_as": false}, "reason": "Same information required by another law (e.g. food, drugs, cosmetics, medical devices) — Rule 7(1)-(3) not applied."}]'::jsonb, '{"fn": "letter_size_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Declaration letters are smaller/narrower than Rule 7(3) allows.', '["label.min_letter_height_mm", "label.min_letter_width_ratio"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R7-3-001', 1);
INSERT INTO rules VALUES ('LMPC-R8-1-001', 1, 'active', 'All declarations appear on the principal display panel', 'PLACEMENT', 'LMPC2011:8(1), 2(h)', '{"source": "LMPC Rules 2011", "rule": "8(1), 2(h)", "pdf_page": 9, "text_excerpt": "Every declaration required to be made under these rules shall appear on the principal display panel."}'::jsonb, 'VISION_AUTOMATED', 'MEDIUM', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "label.all_declarations_grouped_on_pdp", "op": "eq", "value": true}'::jsonb, 'REQUIRES_VERIFICATION', 'Mandatory declarations appear scattered outside the principal display panel.', '["label.layout"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'PDP may be grouped at one place, or pre-printed info in one place and online-printed info (date, batch) in another (Rule 2(h)).');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R8-1-001', 1);
INSERT INTO rules VALUES ('LMPC-R8-1-002', 1, 'active', 'Clear space around the quantity declaration', 'PLACEMENT', 'LMPC2011:8(1) proviso', '{"source": "LMPC Rules 2011", "rule": "8(1) proviso", "pdf_page": 9, "text_excerpt": "free from printed information (a) above and below by a space equal to at least the height of the numeral ... (b) to the left and right by a space at least twice the height of numeral"}'::jsonb, 'VISION_AUTOMATED', 'LOW', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "net_quantity.value", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "quantity_clear_space_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Other printed matter is too close to the net quantity declaration.', '["net_quantity.clearance"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'Scale-invariant — computed from bounding boxes as a ratio to numeral height.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R8-1-002', 1);
INSERT INTO rules VALUES ('LMPC-R9-1a-001', 1, 'active', 'Declarations legible and prominent', 'LEGIBILITY', 'LMPC2011:9(1)(a), 9(1) proviso (b)', '{"source": "LMPC Rules 2011", "rule": "9(1)(a), 9(1) proviso (b)", "pdf_page": 10, "text_excerpt": "Every declaration ... shall be (a) legible and prominent"}'::jsonb, 'VISION_AUTOMATED', 'MEDIUM', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "label.min_declaration_ocr_confidence", "op": "gte", "value": {"policy": "min_ocr_confidence_for_legible"}}'::jsonb, 'REQUIRES_VERIFICATION', 'Some mandatory declarations are hard to read (low OCR confidence) — officer to confirm legibility.', '["label.min_declaration_ocr_confidence"]'::jsonb, 'ENGINEERING_POLICY', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'OCR confidence is only a proxy for legibility; the law gives no number.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R9-1a-001', 1);
INSERT INTO rules VALUES ('LMPC-R9-1b-001', 1, 'active', 'MRP and net-quantity numerals in a colour contrasting with the background', 'LEGIBILITY', 'LMPC2011:9(1)(b)', '{"source": "LMPC Rules 2011", "rule": "9(1)(b)", "pdf_page": 10, "text_excerpt": "numerals of the retail sale price and net quantity declaration shall be printed ... in a colour that contrasts conspicuously with the background"}'::jsonb, 'VISION_AUTOMATED', 'MEDIUM', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "9(1) proviso (a)", "when": {"fact": "label.is_blown_formed_moulded_on_glass_or_plastic", "op": "eq", "value": true, "absent_as": false}, "reason": "Blown/formed/moulded on glass or plastic."}]'::jsonb, '{"all": [{"fact": "mrp.contrast_ratio", "op": "gte", "value": {"policy": "min_contrast_ratio_for_conspicuous"}}, {"fact": "net_quantity.contrast_ratio", "op": "gte", "value": {"policy": "min_contrast_ratio_for_conspicuous"}}]}'::jsonb, 'REQUIRES_VERIFICATION', 'MRP/net-quantity numerals have low colour contrast against the background.', '["mrp", "net_quantity"]'::jsonb, 'ENGINEERING_POLICY', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R9-1b-001', 1);
INSERT INTO rules VALUES ('LMPC-R9-2-001', 1, 'active', 'No declaration that must be read through a liquid', 'PLACEMENT', 'LMPC2011:9(2)', '{"source": "LMPC Rules 2011", "rule": "9(2)", "pdf_page": 10, "text_excerpt": "No declaration shall be made so as to require it to be read through any liquid commodity contained in the package."}'::jsonb, 'MANUAL_INSPECTION', 'LOW', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "label.read_through_liquid", "op": "eq", "value": false}'::jsonb, 'NON_COMPLIANT', 'A declaration can only be read through the liquid contents.', '[]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R9-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R9-3-001', 1, 'active', 'Outer container/wrapper repeats all declarations unless transparent', 'PLACEMENT', 'LMPC2011:9(3)', '{"source": "LMPC Rules 2011", "rule": "9(3)", "pdf_page": 10, "text_excerpt": "Where a package is provided with an outside container or wrapper such container or wrapper shall also contain all the declarations ... except where such container or wrapper itself is transparent"}'::jsonb, 'MANUAL_INSPECTION', 'MEDIUM', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "package.has_outer_wrapper", "op": "eq", "value": true, "absent_as": false}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"any": [{"fact": "package.outer_wrapper_has_all_declarations", "op": "eq", "value": true}, {"fact": "package.outer_wrapper_transparent_and_readable", "op": "eq", "value": true}]}'::jsonb, 'NON_COMPLIANT', 'Outer wrapper hides declarations and does not repeat them.', '[]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R9-3-001', 1);
INSERT INTO rules VALUES ('LMPC-R9-4-001', 1, 'active', 'Declarations in English or Hindi (Devanagari)', 'LANGUAGE', 'LMPC2011:9(4)', '{"source": "LMPC Rules 2011", "rule": "9(4)", "pdf_page": 10, "text_excerpt": "The particulars of the declarations ... shall either be in Hindi in Devnagri script or in English"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "label.declaration_languages", "op": "contains_any", "value": ["en", "hi-Deva"]}'::jsonb, 'NON_COMPLIANT', 'Mandatory declarations are not in English or Hindi (Devanagari).', '["label.declaration_languages"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R9-4-001', 1);
INSERT INTO rules VALUES ('LMPC-R21-2-001', 1, 'active', 'Single package: deficiency in net quantity within maximum permissible error', 'NET_CONTENT', 'LMPC2011:21(2)-(3), 22, First Schedule', '{"source": "LMPC Rules 2011", "rule": "21(2)-(3), 22, First Schedule", "pdf_page": 21, "text_excerpt": "whether the deficiency is more than the maximum permissible error in relation to that commodity"}'::jsonb, 'MEASUREMENT_REQUIRED', 'CRITICAL', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "measurement.actual_net_quantity_base", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "single_package_within_mpe", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Measured net quantity is short of the declared quantity by more than the MPE.', '["measurement.actual_net_quantity_base", "net_quantity"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', '21(3) proviso: if ''when packed'' and shortage due to environment, no punitive action against dealer -> REQUIRES_VERIFICATION.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R21-2-001', 1);
INSERT INTO rules VALUES ('LMPC-R19-6-001', 1, 'active', 'Lot approval: sample average >= declared and no sample short beyond MPE', 'NET_CONTENT', 'LMPC2011:19(6), Fifth & Sixth Schedule', '{"source": "LMPC Rules 2011", "rule": "19(6), Fifth & Sixth Schedule", "pdf_page": 19, "text_excerpt": "the statistical average of the net quantity ... is equal to, or more than, the quantity declared ... the extent of error in deficiency in none of such sample packages exceeds the maximum permissible error"}'::jsonb, 'MEASUREMENT_REQUIRED', 'CRITICAL', '{"all": [{"macro": "RETAIL_SCOPE"}, {"fact": "measurement.sample_net_quantities_base", "op": "exists"}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fn": "lot_test_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Lot fails: average below declared quantity or a sample short beyond MPE (or sample size below Fifth Schedule).', '["measurement.sample_net_quantities_base", "measurement.lot_size"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R19-6-001', 1);
INSERT INTO rules VALUES ('LMPC-R23-001', 1, 'active', 'Package is not deceptive (no exaggerated impression of quantity)', 'NET_CONTENT', 'LMPC2011:23 Explanation', '{"source": "LMPC Rules 2011", "rule": "23 Explanation", "pdf_page": 22, "text_excerpt": "''deceptive package'' means a package which is so designed as to deliberately given to the consumer an exaggerated or misleading impression as to the quantity"}'::jsonb, 'MANUAL_INSPECTION', 'HIGH', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "inspection.deceptive_package", "op": "eq", "value": false}'::jsonb, 'NON_COMPLIANT', 'Package design gives a misleading impression of quantity (slack fill) without protection/machine justification.', '[]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R23-001', 1);
INSERT INTO rules VALUES ('LMPC-R24-a-001', 1, 'active', 'Wholesale package: name and address of manufacturer/importer/packer', 'WHOLESALE', 'LMPC2011:24(a)', '{"source": "LMPC Rules 2011", "rule": "24(a)", "pdf_page": 23, "text_excerpt": "The name and address of the manufacturer or importer or where the manufacturer or importer is not the packer, of the packer"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"fact": "package.level", "op": "eq", "value": "wholesale"}]}'::jsonb, '[{"exemption_ref": "24 proviso", "when": {"fact": "other_law.wholesale_declaration_required", "op": "eq", "value": true, "absent_as": false}, "reason": "Similar declaration required by another law."}]'::jsonb, '{"any": [{"all": [{"fact": "manufacturer.name", "op": "exists"}, {"fact": "manufacturer.address.text", "op": "exists"}]}, {"all": [{"fact": "importer.name", "op": "exists"}, {"fact": "importer.address.text", "op": "exists"}]}, {"all": [{"fact": "packer.name", "op": "exists"}, {"fact": "packer.address.text", "op": "exists"}]}]}'::jsonb, 'NON_COMPLIANT', 'Wholesale package lacks name and address of manufacturer/importer/packer.', '["manufacturer", "importer", "packer"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R24-a-001', 1);
INSERT INTO rules VALUES ('LMPC-R24-b-001', 1, 'active', 'Wholesale package: identity of the commodity', 'WHOLESALE', 'LMPC2011:24(b)', '{"source": "LMPC Rules 2011", "rule": "24(b)", "pdf_page": 23, "text_excerpt": "the identity of the commodity contained in the package"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"fact": "package.level", "op": "eq", "value": "wholesale"}]}'::jsonb, '[{"exemption_ref": "24 proviso", "when": {"fact": "other_law.wholesale_declaration_required", "op": "eq", "value": true, "absent_as": false}, "reason": "Similar declaration required by another law."}]'::jsonb, '{"fact": "product.common_name", "op": "exists"}'::jsonb, 'NON_COMPLIANT', 'Wholesale package does not identify the commodity.', '["product.common_name"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R24-b-001', 1);
INSERT INTO rules VALUES ('LMPC-R24-c-001', 1, 'active', 'Wholesale package: number of retail packages or net quantity', 'WHOLESALE', 'LMPC2011:24(c)', '{"source": "LMPC Rules 2011", "rule": "24(c)", "pdf_page": 23, "text_excerpt": "the total number of retail package contained in such wholesale package or the net quantity"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"all": [{"fact": "package.level", "op": "eq", "value": "wholesale"}]}'::jsonb, '[{"exemption_ref": "24 proviso", "when": {"fact": "other_law.wholesale_declaration_required", "op": "eq", "value": true, "absent_as": false}, "reason": "Similar declaration required by another law."}]'::jsonb, '{"any": [{"fact": "package.retail_package_count", "op": "exists"}, {"fact": "net_quantity.value", "op": "exists"}]}'::jsonb, 'NON_COMPLIANT', 'Wholesale package states neither number of retail packs nor net quantity.', '["package.retail_package_count", "net_quantity"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R24-c-001', 1);
INSERT INTO rules VALUES ('LMPC-R25-001', 1, 'active', 'Export package sold in India is re-packed/re-labelled per Chapter II', 'EXPORT', 'LMPC2011:25', '{"source": "LMPC Rules 2011", "rule": "25", "pdf_page": 23, "text_excerpt": "An export package shall not be sold in India unless the manufacturer or packer has re-packed or relabeled the commodity in accordance with the provisions contained in Chapter II"}'::jsonb, 'LABEL_AUTOMATED', 'CRITICAL', '{"all": [{"fact": "package.level", "op": "eq", "value": "export"}, {"fact": "package.offered_for_sale_in_india", "op": "eq", "value": true}]}'::jsonb, '[]'::jsonb, '{"fact": "package.relabelled_for_india", "op": "eq", "value": true}'::jsonb, 'NON_COMPLIANT', 'Export package offered for sale in India without Indian re-labelling.', '[]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'If relabelled, re-run the inspection with package.level = retail.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R25-001', 1);
INSERT INTO rules VALUES ('LMPC-R27-001', 1, 'active', 'Manufacturer / packer / importer registered with Director or Controller', 'REGISTRATION', 'LMPC2011:27', '{"source": "LMPC Rules 2011", "rule": "27", "pdf_page": 24, "text_excerpt": "Every individual, firm ... who or which pre-packs or imports any commodity for sale ... shall make an application ... for the registration"}'::jsonb, 'EXTERNAL_LOOKUP', 'HIGH', '{"any": [{"macro": "RETAIL_SCOPE"}, {"all": [{"fact": "package.level", "op": "eq", "value": "wholesale"}]}]}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}]'::jsonb, '{"fact": "registry.packer_or_importer_registered", "op": "eq", "value": true}'::jsonb, 'NON_COMPLIANT', 'No Legal Metrology registration found for the packer/importer.', '["manufacturer.name"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', 'Needs registry lookup (state LM portals). Penalty under Rule 32(1).');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R27-001', 1);
INSERT INTO rules VALUES ('LMPC-R31-001', 1, 'active', 'Advertisement mentioning RSP also states net quantity in the same font size', 'ADVERTISEMENT', 'LMPC2011:31', '{"source": "LMPC Rules 2011", "rule": "31", "pdf_page": 26, "text_excerpt": "Any advertisement mentioning the retail sale price ... shall contain a declaration as to the net quantity ... The font size of the net quantity ... shall be same as that of retail sale price."}'::jsonb, 'LABEL_AUTOMATED', 'MEDIUM', '{"all": [{"fact": "inspection.input_type", "op": "eq", "value": "advertisement", "absent_as": false}, {"fact": "ad.mentions_rsp", "op": "eq", "value": true}]}'::jsonb, '[]'::jsonb, '{"all": [{"fact": "ad.net_quantity_text", "op": "exists"}, {"fn": "ad_font_sizes_match", "args": {}}]}'::jsonb, 'NON_COMPLIANT', 'Advertisement shows price without net quantity in the same font size.', '["ad"]'::jsonb, 'LAW', '2011-04-01', NULL, 'AS_PER_2011_TEXT', NULL);
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-R31-001', 1);
INSERT INTO rules VALUES ('LMPC-USP-001', 1, 'draft', 'Unit sale price declared (per g/kg, ml/l, cm/m or per unit)', 'PRICE_DECLARATION', 'LMPC2011:6(1) as amended (unit sale price)', '{"source": "LMPC Rules 2011", "rule": "6(1) as amended (unit sale price)", "pdf_page": null, "text_excerpt": "[amended text to be pasted from Gazette]"}'::jsonb, 'LABEL_AUTOMATED', 'HIGH', '{"macro": "RETAIL_SCOPE"}'::jsonb, '[{"exemption_ref": "Rule 26", "when": {"macro": "RULE26_EXEMPT"}, "reason": "Exempt from the Rules under Rule 26 (<=10 g/ml, restaurant fast food, DPCO drugs, farm produce >50 kg)."}, {"exemption_ref": "amended proviso", "when": {"fact": "product.tags", "op": "contains", "value": "alcoholic_beverage"}, "reason": "Alcoholic beverages under State Excise law (reported)."}, {"exemption_ref": "amended proviso", "when": {"fn": "usp_equals_rsp", "args": {}}, "reason": "Retail sale price equals unit sale price (reported)."}]'::jsonb, '{"fn": "unit_sale_price_ok", "args": {}}'::jsonb, 'NON_COMPLIANT', 'Unit sale price not declared or not in the prescribed unit.', '["unit_sale_price", "mrp", "net_quantity"]'::jsonb, 'LAW', '2022-04-01', NULL, 'DRAFT_PENDING_GAZETTE_VERIFICATION', 'Secondary sources describe per-1 g / per-1 ml etc. below 1 kg/l and per-kg/l at or above, rounded to 2 decimals; enforcement dates reported as 2022, 2023 and 2024 in different sources. Activate only after confirming the Gazette text.');
INSERT INTO rule_set_members VALUES ('2026.09-draft1', 'LMPC-USP-001', 1);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'meta', '{"source": "The Legal Metrology (Packaged Commodities) Rules, 2011 — GSR 202(E), 7 March 2011 (text as uploaded, incl. GSR 748(E) notes)", "base_units": {"mass": "g", "volume": "ml", "length": "cm", "area": "cm2", "number": "count"}, "band_interpretation": "Band ''A to B'' is read as (A, B]; ''up to A'' is [0, A]. The First Schedule bands are continuous at every boundary (e.g. 9% of 50 = 4.5 g; 4.5% of 200 = 9 g), so this choice does not change any MPE value. Exception created by the rounding rule itself: just above 1000 g the percentage MPE rounds UP to the next whole gram (1001 g -> 16 g, while 1000 g -> 15 g).", "status_note": "These are 2011 values. The Second Schedule was later omitted and several tables amended — see amendment_register in lmpc_2011_rules.json."}'::jsonb);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'first_schedule_mpe_weight_volume', '{"provision": "First Schedule, para 1, Table I; Rule 2(e), Rule 22", "unit": "g or ml", "bands": [{"above": 0, "up_to": 50, "percent": 9.0}, {"above": 50, "up_to": 100, "absolute": 4.5}, {"above": 100, "up_to": 200, "percent": 4.5}, {"above": 200, "up_to": 300, "absolute": 9}, {"above": 300, "up_to": 500, "percent": 3.0}, {"above": 500, "up_to": 1000, "absolute": 15}, {"above": 1000, "up_to": 10000, "percent": 1.5}, {"above": 10000, "up_to": 15000, "absolute": 150}, {"above": 15000, "up_to": null, "percent": 1.0}], "rounding": {"provision": "First Schedule, para 1(2)", "declared_up_to_1000": "round percentage-derived MPE to nearest 0.1 g/ml", "declared_above_1000": "round percentage-derived MPE up to the next whole g/ml"}}'::jsonb);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'first_schedule_mpe_length_area_number', '{"provision": "First Schedule, para 2, Table II", "length": {"threshold_cm": 1000, "percent_up_to_threshold": 2.0, "percent_above_threshold": 1.0}, "area": {"threshold_cm2": 100000, "percent_up_to_threshold": 4.0, "percent_above_threshold": 1.0}, "number": {"percent": 2.0}, "interpretation_flag": "Text says ''2% up to 10 metre and thereafter 1% of declared quantity''. Implemented as: declared <= 10 m -> 2% of declared; declared > 10 m -> 1% of declared. Confirm with Legal Metrology officer (alternative reading is marginal)."}'::jsonb);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'rule7_table1_numeral_height_weight_volume', '{"provision": "Rule 7(2)(i), Table-I", "key": "net quantity in g or ml", "bands": [{"above": 0, "up_to": 200, "normal_mm": 1, "embossed_mm": 2}, {"above": 200, "up_to": 500, "normal_mm": 2, "embossed_mm": 4}, {"above": 500, "up_to": null, "normal_mm": 4, "embossed_mm": 6}]}'::jsonb);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'rule7_table2_numeral_height_length_area_number', '{"provision": "Rule 7(2)(ii), Table-II", "key": "area of principal display panel in cm2", "bands": [{"above": 0, "up_to": 100, "normal_mm": 1, "embossed_mm": 2}, {"above": 100, "up_to": 500, "normal_mm": 2, "embossed_mm": 4}, {"above": 500, "up_to": 2500, "normal_mm": 4, "embossed_mm": 6}, {"above": 2500, "up_to": null, "normal_mm": 6, "embossed_mm": 6}]}'::jsonb);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'rule7_letter_size', '{"provision": "Rule 7(3)", "min_letter_height_mm": {"normal": 1, "embossed": 2}, "min_width_to_height_ratio": 0.3333, "ratio_exempt_glyphs": ["1", "i", "I", "l"]}'::jsonb);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'rule8_quantity_clear_space', '{"provision": "Rule 8(1) proviso", "min_vertical_clearance_x_numeral_height": 1.0, "min_horizontal_clearance_x_numeral_height": 2.0, "note": "Scale-invariant: can be computed from pixel bounding boxes without knowing physical size."}'::jsonb);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'second_schedule_standard_sizes', '{"provision": "Rule 5 read with Second Schedule", "effective_from": "2011-04-01", "effective_to": "2022-03-31", "effective_to_status": "VERIFY — reported omitted by the 2021/2022 amendments; confirm the exact commencement date from the Gazette notification before relying on it", "commodities": {"baby_food": {"sl": "1", "dimension": "mass", "explicit": [100, 200, 300, 400, 500, 600, 700, 800, 900, 1000, 2000, 5000, 10000]}, "weaning_food": {"sl": "2", "dimension": "mass", "explicit": [100, 200, 300, 400, 500, 600, 700, 800, 900, 1000, 2000, 5000, 10000]}, "biscuits": {"sl": "3", "dimension": "mass", "explicit": [25, 50, 75, 100, 150, 200, 250, 300], "thereafter_multiples_of": 100, "multiples_up_to": 1000}, "bread": {"sl": "4", "dimension": "mass", "explicit": [100], "thereafter_multiples_of": 100, "note": "includes brown bread, excludes bun"}, "butter_margarine_uncanned": {"sl": "5", "dimension": "mass", "explicit": [25, 50, 100, 200, 500, 1000, 2000, 5000], "thereafter_multiples_of": 5000}, "cereals_pulses": {"sl": "6", "dimension": "mass", "explicit": [100, 200, 500, 1000, 2000, 5000], "thereafter_multiples_of": 5000}, "coffee": {"sl": "7", "dimension": "mass", "explicit": [25, 50, 100, 200, 250, 500, 1000], "thereafter_multiples_of": 1000}, "tea": {"sl": "8", "dimension": "mass", "explicit": [25, 50, 100, 125, 250, 500, 1000], "thereafter_multiples_of": 1000}, "beverage_material": {"sl": "9", "dimension": "mass", "explicit": [25, 50, 100, 200, 500, 1000], "thereafter_multiples_of": 1000}, "edible_oil_ghee": {"sl": "10", "dimension": "mass_or_volume", "explicit": [50, 100, 200, 500, 1000, 2000, 3000, 5000], "thereafter_multiples_of": 5000, "extra_requirement": "If declared by volume, equivalent mass to be declared in brackets in the same size of letters/numerals"}, "milk_powder": {"sl": "11", "dimension": "mass", "explicit": [50, 100, 200, 500, 1000], "thereafter_multiples_of": 500, "below_no_restriction": 50}, "detergent_powder": {"sl": "12", "dimension": "mass", "explicit": [50, 100, 200, 500, 700, 1000, 1500, 2000], "thereafter_multiples_of": 1000, "below_no_restriction": 50}, "rice_flour_atta_rawa_suji": {"sl": "13", "dimension": "mass", "explicit": [100, 200, 500, 1000, 2000, 5000], "thereafter_multiples_of": 5000}, "salt": {"sl": "14", "dimension": "mass", "explicit": [50, 100, 200, 500, 750, 1000, 2000, 5000], "thereafter_multiples_of": 5000, "below_first_explicit_multiples_of": 10}, "laundry_soap": {"sl": "15a", "dimension": "mass", "explicit": [50, 75, 100], "thereafter_multiples_of": 50}, "detergent_cake": {"sl": "15b", "dimension": "mass", "explicit": [50, 75, 100, 125, 150, 200, 250, 300], "thereafter_multiples_of": 100}, "toilet_soap": {"sl": "15c", "dimension": "mass", "explicit": [25, 50, 75, 100, 125, 150], "thereafter_multiples_of": 50}, "soft_drink_non_alcoholic": {"sl": "16", "dimension": "volume", "explicit": [65, 100, 125, 150, 200, 250, 300, 330, 500, 750, 1000, 1500, 2000, 3000, 4000, 5000], "conditional_sizes": {"65": "fruit_based_drink", "125": "fruit_based_drink", "330": "can"}}, "drinking_water": {"sl": "17", "dimension": "volume", "explicit": [100, 150, 200, 250, 300, 500, 750, 1000, 1500, 2000, 3000, 4000, 5000]}, "cement_bag": {"sl": "18", "dimension": "mass", "explicit": [1000, 2000, 5000, 10000, 20000, 25000, 40000, 50000], "conditional_sizes": {"40000": "white_cement"}}, "paint_liquid": {"sl": "19a", "dimension": "volume", "explicit": [50, 100, 200, 500, 1000, 2000, 3000, 4000, 5000], "thereafter_multiples_of": 5000}, "paint_paste_solid": {"sl": "19b", "dimension": "mass", "explicit": [500, 1000, 1500, 2000, 3000, 5000, 7000], "thereafter_multiples_of": 5000}, "paint_base": {"sl": "19c", "dimension": "volume", "explicit": [450, 500, 900, 925, 950, 975, 1000, 3600, 3700, 3800, 3900, 4000], "above_no_restriction": 4000}}}'::jsonb);
INSERT INTO reference_tables VALUES ('2026.09-draft1', 'third_schedule_when_packed', '{"provision": "Rule 11(4) read with Third Schedule", "tags": ["soap", "lotion", "cream_non_dairy"], "labels": ["All kinds of soaps", "Lotions", "Cream (other than cream of milk)"]}'::jsonb);
