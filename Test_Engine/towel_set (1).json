"""Generate seed.sql from rules/*.json  (python make_seed.py > seed.sql)"""
import hashlib, json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
rules_txt = (ROOT / "rules" / "lmpc_2011_rules.json").read_text()
tables_txt = (ROOT / "rules" / "reference_tables.json").read_text()
rs, tables = json.loads(rules_txt), json.loads(tables_txt)

def q(v):
    if v is None: return "NULL"
    if isinstance(v, (dict, list)): v = json.dumps(v, ensure_ascii=False)
    return "'" + str(v).replace("'", "''") + "'"

sha = hashlib.sha256((rules_txt + tables_txt).encode()).hexdigest()
ver = rs["rule_set_version"]
out = ["BEGIN;"]
out.append(f"INSERT INTO rule_sets VALUES ({q(ver)}, {q(rs['rule_set_id'])}, {q(rs['title'])}, 'draft', {q(rs['macros'])}::jsonb, {q(rs['fact_vocabulary'])}::jsonb, NULL, {q(sha)});")
provs = {}
for r in rs["rules"]:
    pid = f"LMPC2011:{r['provision']['rule']}"
    provs.setdefault(pid, r)
for pid, r in provs.items():
    out.append(f"INSERT INTO legal_provisions (provision_id, source, rule_ref, pdf_page, text, effective_from, effective_to) VALUES "
               f"({q(pid)}, {q(r['provision']['source'])}, {q(r['provision']['rule'])}, {q(r['provision']['pdf_page'])}, {q(r['provision']['text_excerpt'])}, {q(r['effective_from'])}, {q(r['effective_to'])}) ON CONFLICT DO NOTHING;")
for r in rs["rules"]:
    pid = f"LMPC2011:{r['provision']['rule']}"
    out.append("INSERT INTO rules VALUES (" + ", ".join([
        q(r["rule_id"]), str(r["version"]), q(r["status"]), q(r["title"]), q(r["category"]), q(pid),
        q(r["provision"]) + "::jsonb", q(r["verification_mode"]), q(r["severity"]),
        q(r["applies_when"]) + "::jsonb", q(r["exempt_when"]) + "::jsonb", q(r["check"]) + "::jsonb",
        q(r["outcome_on_fail"]), q(r["fail_message"]), q(r["evidence_facts"]) + "::jsonb", q(r["threshold_source"]),
        q(r["effective_from"]), q(r["effective_to"]), q(r["amendment_status"]), q(r.get("notes"))]) + ");")
    out.append(f"INSERT INTO rule_set_members VALUES ({q(ver)}, {q(r['rule_id'])}, {r['version']});")
for name, data in tables.items():
    out.append(f"INSERT INTO reference_tables VALUES ({q(ver)}, {q(name)}, {q(data)}::jsonb);")
out.append("COMMIT;")
print("\n".join(out))
