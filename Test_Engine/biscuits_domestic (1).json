-- PostgreSQL schema for the data-driven Legal Metrology compliance engine
-- Rules are DATA (JSONB). The interpreter is code. Inspections pin a rule-set version.
CREATE EXTENSION IF NOT EXISTS vector;   -- pgvector, only for legal_provisions (RAG explanations)

-- ----------------------------------------------------------------- legal corpus (for citation + RAG)
CREATE TABLE legal_provisions (
    provision_id     TEXT PRIMARY KEY,              -- e.g. 'LMPC2011:6(2)'
    source           TEXT NOT NULL,                 -- 'LMPC Rules 2011'
    rule_ref         TEXT NOT NULL,                 -- '6(2)'
    pdf_page         INT,
    text             TEXT NOT NULL,
    effective_from   DATE NOT NULL,
    effective_to     DATE,
    embedding        vector(768)                    -- filled by the embedding job
);

-- ----------------------------------------------------------------- rule authoring
CREATE TABLE rule_sets (
    rule_set_version TEXT PRIMARY KEY,              -- '2026.09-draft1'
    rule_set_id      TEXT NOT NULL,                 -- 'LMPC-2011-TEXT'
    title            TEXT NOT NULL,
    status           TEXT NOT NULL CHECK (status IN ('draft','published','retired')),
    macros           JSONB NOT NULL,
    fact_vocabulary  JSONB NOT NULL,
    published_at     TIMESTAMPTZ,
    content_sha256   TEXT                            -- hash of rules+tables at publish time (reproducibility)
);

CREATE TABLE rules (
    rule_id            TEXT NOT NULL,
    version            INT  NOT NULL,
    status             TEXT NOT NULL CHECK (status IN ('active','draft','retired')),
    title              TEXT NOT NULL,
    category           TEXT NOT NULL,
    provision_id       TEXT REFERENCES legal_provisions(provision_id),
    provision          JSONB NOT NULL,              -- {source, rule, pdf_page, text_excerpt}
    verification_mode  TEXT NOT NULL,
    severity           TEXT NOT NULL CHECK (severity IN ('CRITICAL','HIGH','MEDIUM','LOW','INFO')),
    applies_when       JSONB NOT NULL,
    exempt_when        JSONB NOT NULL DEFAULT '[]',
    check_expr         JSONB NOT NULL,
    outcome_on_fail    TEXT NOT NULL,
    fail_message       TEXT NOT NULL,
    evidence_facts     JSONB NOT NULL DEFAULT '[]',
    threshold_source   TEXT NOT NULL CHECK (threshold_source IN ('LAW','ENGINEERING_POLICY')),
    effective_from     DATE NOT NULL,
    effective_to       DATE,
    amendment_status   TEXT NOT NULL,
    notes              TEXT,
    PRIMARY KEY (rule_id, version),
    CHECK (effective_to IS NULL OR effective_to >= effective_from)
);
CREATE INDEX rules_effective_idx ON rules (effective_from, effective_to) WHERE status = 'active';

-- which rule versions make up a published rule set (immutable once published)
CREATE TABLE rule_set_members (
    rule_set_version TEXT REFERENCES rule_sets(rule_set_version),
    rule_id          TEXT,
    version          INT,
    PRIMARY KEY (rule_set_version, rule_id, version),
    FOREIGN KEY (rule_id, version) REFERENCES rules(rule_id, version)
);

CREATE TABLE reference_tables (
    rule_set_version TEXT REFERENCES rule_sets(rule_set_version),
    table_name       TEXT NOT NULL,                 -- 'first_schedule_mpe_weight_volume'
    data             JSONB NOT NULL,
    PRIMARY KEY (rule_set_version, table_name)
);

-- ----------------------------------------------------------------- inspections
CREATE TABLE products (
    product_id     UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    brand          TEXT,
    common_name    TEXT,
    tags           TEXT[] NOT NULL DEFAULT '{}'
);

CREATE TABLE inspections (
    inspection_id    TEXT PRIMARY KEY,              -- 'INS-2026-00125'
    product_id       UUID REFERENCES products(product_id),
    rule_set_version TEXT NOT NULL REFERENCES rule_sets(rule_set_version),
    judged_as_of     DATE NOT NULL,                 -- selects rule versions by effective dates
    officer_id       TEXT,
    location         TEXT,
    automated_verdict TEXT CHECK (automated_verdict IN ('COMPLIANT','NON_COMPLIANT','REQUIRES_VERIFICATION','EXEMPT')),
    final_verdict    TEXT,                          -- after human review
    created_at       TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE inspection_images (
    image_id       TEXT PRIMARY KEY,
    inspection_id  TEXT NOT NULL REFERENCES inspections(inspection_id),
    panel          TEXT,                            -- front/back/side/top/bottom
    storage_uri    TEXT NOT NULL,
    width_px INT, height_px INT
);

-- one row per fact path; AI value and human value both kept (audit trail)
CREATE TABLE extracted_facts (
    inspection_id       TEXT NOT NULL REFERENCES inspections(inspection_id),
    fact_path           TEXT NOT NULL,              -- 'mrp.value'
    ai_value            JSONB,
    ai_confidence       REAL,
    extractor           TEXT,                       -- 'ocr:paddle-2.8', 'gemini-x', 'classifier:v3'
    image_id            TEXT REFERENCES inspection_images(image_id),
    bbox                INT[4],
    human_value         JSONB,
    verification_status TEXT NOT NULL DEFAULT 'UNVERIFIED' CHECK (verification_status IN ('UNVERIFIED','VERIFIED','REJECTED')),
    verified_by         TEXT,
    verified_at         TIMESTAMPTZ,
    PRIMARY KEY (inspection_id, fact_path)
);

CREATE TABLE rule_results (
    inspection_id     TEXT NOT NULL REFERENCES inspections(inspection_id),
    rule_id           TEXT NOT NULL,
    rule_version      INT  NOT NULL,
    status            TEXT NOT NULL CHECK (status IN ('COMPLIANT','NON_COMPLIANT','REQUIRES_VERIFICATION','NOT_APPLICABLE','EXEMPT','OBSERVATION')),
    queue             TEXT,                         -- REVIEW | MANUAL_CHECKLIST
    reason            TEXT,
    exemption_ref     TEXT,
    missing_facts     TEXT[],
    low_conf_facts    TEXT[],
    assumptions       JSONB,
    evidence          JSONB,                        -- [{fact, value, confidence, source, image_id, bbox}]
    evaluated_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    run_no            INT NOT NULL DEFAULT 1,       -- re-evaluation after human correction = new run
    PRIMARY KEY (inspection_id, rule_id, rule_version, run_no),
    FOREIGN KEY (rule_id, rule_version) REFERENCES rules(rule_id, version)
);

-- violations = NON_COMPLIANT results the officer confirmed (or auto-confirmed by policy)
CREATE TABLE violations (
    violation_id     TEXT PRIMARY KEY,
    inspection_id    TEXT NOT NULL REFERENCES inspections(inspection_id),
    rule_id          TEXT NOT NULL,
    rule_version     INT NOT NULL,
    severity         TEXT NOT NULL,
    observed_value   JSONB,
    expected         TEXT,
    llm_explanation  TEXT,                          -- generated from rule + provision text; never decides
    officer_decision TEXT CHECK (officer_decision IN ('CONFIRMED','OVERTURNED','PENDING')) DEFAULT 'PENDING',
    FOREIGN KEY (rule_id, rule_version) REFERENCES rules(rule_id, version)
);
