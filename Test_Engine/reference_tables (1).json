"""Sanity tests for the rule set + interpreter.  Run:  python -m pytest -q  (or python test_engine.py)"""
import json
from datetime import date
from pathlib import Path

import engine as E

ROOT = Path(__file__).resolve().parent.parent
RULES = json.loads((ROOT / "rules" / "lmpc_2011_rules.json").read_text())
TABLES = json.loads((ROOT / "rules" / "reference_tables.json").read_text())


def walk(node):
    if isinstance(node, dict):
        yield node
        for v in node.values():
            yield from walk(v)
    elif isinstance(node, list):
        for v in node:
            yield from walk(v)


def test_every_rule_is_well_formed():
    required = {"rule_id", "version", "status", "title", "provision", "verification_mode", "severity",
                "applies_when", "exempt_when", "check", "effective_from", "effective_to"}
    seen = set()
    for r in RULES["rules"]:
        assert required <= r.keys(), r["rule_id"]
        assert (r["rule_id"], r["version"]) not in seen
        seen.add((r["rule_id"], r["version"]))
        assert r["verification_mode"] in RULES["verification_modes"]
        assert r["provision"]["text_excerpt"]


def test_all_fn_macro_policy_and_table_references_resolve():
    for node in walk([RULES["rules"], RULES["macros"]]):
        if "fn" in node:
            assert node["fn"] in E.FUNCTIONS, node["fn"]
            if "table" in node.get("args", {}):
                assert node["args"]["table"] in TABLES
        if "macro" in node:
            assert node["macro"] in RULES["macros"]
        if isinstance(node.get("value"), dict) and "policy" in node["value"]:
            assert node["value"]["policy"] in TABLES["engineering_policy"]
        if "op" in node and "fact" in node:
            assert node["op"] in {"exists", "eq", "ne", "in", "not_in", "contains", "contains_any",
                                  "matches_regex", "gt", "gte", "lt", "lte", "between"}


def test_versions_of_same_rule_do_not_overlap():
    by_id = {}
    for r in RULES["rules"]:
        if r["status"] == "active":
            by_id.setdefault(r["rule_id"], []).append(r)
    for rid, vs in by_id.items():
        vs.sort(key=lambda r: r["effective_from"])
        for a, b in zip(vs, vs[1:]):
            assert a["effective_to"] and a["effective_to"] < b["effective_from"], rid


def test_first_schedule_is_continuous_at_band_edges():
    for edge in [50, 100, 200, 300, 500, 1000, 10000, 15000]:
        below, above = E.mpe(edge, "mass", TABLES), E.mpe(edge + 0.001, "mass", TABLES)
        # <= 1.0: above 1000 g the text rounds UP to the next whole gram, so 1000.001 g -> 16 g (not 15)
        assert abs(below - above) <= 1.0, (edge, below, above)
    assert E.mpe(5000, "mass", TABLES) == 75
    assert E.mpe(250, "volume", TABLES) == 9
    assert E.mpe(40, "mass", TABLES) == 3.6


def ctx_for(facts, on=date(2011, 6, 1)):
    fs = E.FactStore(facts, TABLES)
    return E.Ctx(fs, RULES, TABLES, on)


def test_standard_pack_sizes():
    cases = [("biscuits", 400, "g", E.T), ("biscuits", 1100, "g", E.F), ("biscuits", 75, "g", E.T),
             ("salt", 30, "g", E.T), ("salt", 35, "g", E.F), ("salt", 10, "kg", E.T),
             ("milk_powder", 20, "g", E.T), ("paint_base", 4.5, "l", E.T),
             ("soft_drink_non_alcoholic", 330, "ml", E.F), ("tea", 125, "g", E.T)]
    for tag, v, unit, want in cases:
        c = ctx_for({"product.tags": [tag], "net_quantity.value": v, "net_quantity.unit": unit})
        assert E.fn_standard_pack_size_ok(c) == want, (tag, v, unit)
    c = ctx_for({"product.tags": ["soft_drink_non_alcoholic", "can"], "net_quantity.value": 330, "net_quantity.unit": "ml"})
    assert E.fn_standard_pack_size_ok(c) == E.T


def test_unit_conventions():
    for v, u, want in [(500, "g", E.T), (0.5, "kg", E.F), (1500, "g", E.F), (1.5, "kg", E.T), (1000, "g", E.T), (750, "ml", E.T), (2, "l", E.T)]:
        assert E.fn_unit_convention_ok(ctx_for({"net_quantity.value": v, "net_quantity.unit": u})) == want, (v, u)


def test_fourth_schedule_ice_cream_changes_on_1_july_2012():
    facts = {"product.tags": ["ice_cream"], "net_quantity.value": 500, "net_quantity.unit": "ml"}
    assert E.fn_unit_dimension_allowed(ctx_for(facts, date(2012, 1, 1))) == E.T
    assert E.fn_unit_dimension_allowed(ctx_for(facts, date(2013, 1, 1))) == E.F


def test_low_confidence_becomes_unknown_and_verified_value_wins():
    low = {"mrp.value": {"value": 40, "confidence": 0.4}}
    c = ctx_for(low)
    assert E.evaluate({"fact": "mrp.value", "op": "exists"}, c) == E.U
    fixed = {"mrp.value": {"value": 4, "confidence": 0.4, "human_value": 40, "verification_status": "VERIFIED"}}
    c = ctx_for(fixed)
    assert E.evaluate({"fact": "mrp.value", "op": "eq", "value": 40}, c) == E.T


def test_missing_declaration_is_unknown_unless_coverage_complete():
    leaf = {"fact": "consumer_care.phone", "op": "exists"}
    assert E.evaluate(leaf, ctx_for({})) == E.U
    assert E.evaluate(leaf, ctx_for({"extraction.coverage_complete": True})) == E.F


def test_samples_end_to_end():
    expected = {
        "biscuits_domestic": "NON_COMPLIANT",
        "shampoo_imported": "NON_COMPLIANT",
        "salt_450g": "NON_COMPLIANT",
        "shampoo_sachet_8ml": "EXEMPT",
        "towel_set": "NON_COMPLIANT",
        "atta_5kg_lot_test": "NON_COMPLIANT",
    }
    for name, verdict in expected.items():
        rep = E.run(json.loads((ROOT / "samples" / f"{name}.json").read_text()))
        assert rep["automated_verdict"] == verdict, name
    salt = json.loads((ROOT / "samples" / "salt_450g.json").read_text())
    ids_2012 = {r["rule_id"] for r in E.run(salt, date(2012, 1, 15))["results"] if r["status"] == "NON_COMPLIANT"}
    ids_2026 = {r["rule_id"] for r in E.run(salt, date(2026, 9, 11))["results"] if r["status"] == "NON_COMPLIANT"}
    assert {"LMPC-R5-001", "LMPC-R5-002"} <= ids_2012
    assert not ({"LMPC-R5-001", "LMPC-R5-002"} & ids_2026)


if __name__ == "__main__":
    import inspect, sys
    fails = 0
    for name, fn in list(globals().items()):
        if name.startswith("test_") and inspect.isfunction(fn):
            try:
                fn(); print("ok  ", name)
            except AssertionError as e:
                fails += 1; print("FAIL", name, e)
    sys.exit(1 if fails else 0)
