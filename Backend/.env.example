# Database. Supabase/Neon Postgres in normal use; SQLite works for a quick local run.
#   supabase: postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   local:    sqlite:///./data/app.db
DATABASE_URL="sqlite:///./data/app.db"

# Secret for signing JWTs. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="change-me"

# Supabase Storage for package images. Leave blank to store under ./uploads instead.
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="inspection-images"

# LLM used for declaration extraction, classification and explanation.
# Leave LLM_API_KEY blank to run the clearly marked development fallback extractor.
LLM_PROVIDER="google"
LLM_API_KEY=""
LLM_MODEL="gemini-2.0-flash"

# Second pass that re-files the extracted declarations into the correct fields.
# Set INFERENCE_PROVIDER to "openrouter" and put your OpenRouter key in INFERENCE_API_KEY
# to run this pass on a different model from the first extraction.
INFERENCE_ENABLED="true"
INFERENCE_PROVIDER=""
INFERENCE_API_KEY=""
INFERENCE_MODEL=""
LLM_BASE_URL="https://openrouter.ai/api/v1"
EMBEDDING_MODEL="models/gemini-embedding-001"
EMBEDDING_DIM="3072"

# Rule set pinned on new inspections, and the legal source PDF.
RULE_SET_VERSION="2026.09-draft1"
LEGAL_PDF_PATH="legal/lmpc_2011.pdf"

ALLOWED_ORIGINS="http://localhost:5173"

# OCR runs locally with PaddleOCR - no cloud key needed.
# Language model to load: "en" (Latin + digits), "devanagari" for Hindi, etc.
OCR_LANG="en"

# Reject photos whose Laplacian variance (on a 640px sample) is below this.
BLUR_MIN_VARIANCE="80"
BLUR_SAMPLE_EDGE="640"
